# A100 deployment parameters (A100 80 GB: 81,920 MiB, or A100 40 GB: 40,960 MiB; compute capability 8.0): configs/h100.env's parameters — the same variables, probes,
# refusals and JIT-cache keying (MODEL_OPT_STACK_KEY is derived from the installed torch and the visible card on either: torch2.13.0-cu130-sm80
# here) — with this card's one value, the target-GPU word, set first. usage: `run.sh <command> --config a100 --mode <mode> ...`, or
# `source configs/a100.env` before `BOLTZGEN_OPT=<mode> boltzgen run ...`. The package admits the card by compute capability and names it on
# one `[boltzgen-opt] NOTE gpu=… mem=…` line per process (`gpu_gate=noted` in opt_manifest.json); the modes' switches do not change with the card or its memory size.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (A100, 80 GB or 40 GB, compute capability 8.0)
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"                                                                            # keep this line last: configs/h100.env's refusals (its return codes) are this file's
