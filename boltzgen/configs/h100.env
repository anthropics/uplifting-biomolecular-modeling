# H100 deployment parameters (configs/a100.env is the A100's: this file with its target-GPU word). The mode is NOT here: it comes from `--mode` or BOLTZGEN_OPT=exact|off.
# usage: `source configs/h100.env` then `BOLTZGEN_OPT=exact boltzgen run spec.yaml ...` (the installed boltzgen_opt package activates in the
#        parent and, through the environment it exports, in every GPU step process of upstream's default subprocess-per-step pipeline; upstream's
#        `--no_subprocess` runs the steps in one process, a form the kit's unit tests do not cover), or `run.sh design|check|warm
#        --config h100 --mode exact ...` (the kit's own runner as a child process). Every value can be pre-set in the environment; this file fills what is unset except BOLTZGEN_CACHE, which has no default (README "Variables", STOCK.md "Variables"). It refuses by name (rc 3, NOT ACTIVE)
#        when BOLTZGEN_CACHE is unset, when boltzgen_opt is not importable on the `python` on PATH or the core pin gate refuses (`boltzgen_opt.core_gate`, before any other probe: the shared
#        core `opt/pyproject.toml` pins is absent, older, newer or edited) — every route, the stock route included, goes through the package.
# Pinned stack: python 3.11, torch 2.13.0+cu130, triton 3.7.1, cuequivariance 0.11.1 with the CUDA-13 ops build (stock/PINS.json; environment/requirements.lock is the full package list; STOCK.md).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this boltzgen/ directory (the package locates the kits through it)
env -u BOLTZGEN_OPT python -c "import boltzgen_opt" 2>/dev/null || { echo "[boltzgen-opt] NOT ACTIVE: boltzgen_opt is not importable on $(command -v python || echo 'python (not on PATH)'): bash $MODEL_OPT/run.sh install (= pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt)" >&2; return 3 2>/dev/null || exit 3; }
python -c "import boltzgen_opt as k; k.core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                # the core pin gate before any other probe: an absent / older / newer / edited shared core is its one NOT ACTIVE line, rc 3
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (H100 80 GB: 81,559 MiB, compute capability 9.0); the package admits a card by compute capability (>= 8.0) and names a card other than the pinned one on one NOTE line per process
[ -n "${BOLTZGEN_CACHE:-}" ] || { echo "[boltzgen-opt] NOT ACTIVE: BOLTZGEN_CACHE is not set — the directory holding the pinned weights + aux data in HF-cache layout (README \"Variables\"; repos, snapshots and sha256 in stock/PINS.json \"weights\")" >&2; return 3 2>/dev/null || exit 3; }
export BOLTZGEN_CACHE                                                                                                # weights + aux data in HF-cache layout: models--boltzgen--boltzgen-1/snapshots/<snapshot>/*.ckpt, datasets--boltzgen--inference-data/snapshots/<snapshot>/mols.zip (snapshots + sha256 in stock/PINS.json "weights")
export HF_HOME=${HF_HOME:-$BOLTZGEN_CACHE}                                                                           # the same cache for anything that reads HF_HOME
export HF_HUB_OFFLINE=1                                                                                              # nothing is fetched at run time (every `huggingface:` artifact name resolves inside BOLTZGEN_CACHE)
# MODEL_OPT_STACK_KEY: the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g.
# torch2.13.0-cu130-sm90 — from the torch that is installed (its metadata version; no import) and the card that is visible (nvidia-smi);
# the pinned stack's only where nothing is installed / visible. A failure to derive it is named on one NOTE line and the JIT caches below are
# left to Triton's / torch's own per-user defaults for the run (nothing is keyed on a placeholder); the run proceeds.
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then
  _sk_out=$(python -c "from boltzgen_opt.stack import stack_key; print(stack_key())" 2>&1) && _sk_rc=0 || _sk_rc=$?
  if [ "$_sk_rc" -ne 0 ] || [ -z "$_sk_out" ]; then
    echo "[boltzgen-opt] NOTE could not derive MODEL_OPT_STACK_KEY (stack_key() failed, rc=$_sk_rc): $_sk_out — the JIT caches stay at Triton's / torch's per-user defaults for this run" >&2
  else
    export MODEL_OPT_STACK_KEY="$_sk_out"
  fi
  unset _sk_out _sk_rc
fi
# MODEL_OPT_JIT_ROOT (optional): a persistent JIT-cache root shared across machines of one stack. Set -> the Triton cache (upstream's cuEquivariance
# kernels JIT-compile a launcher at the first call; gcc is required), the torch-extensions, TorchInductor and numba caches are keyed under it by the
# running torch+CUDA+arch, each unless already set; unset -> nothing is exported here and every cache stays at its library's default (STOCK.md "Variables").
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ] && [ -n "${MODEL_OPT_STACK_KEY:-}" ]; then
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}
  export TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/inductor}     # written only when a caller opts into upstream's torch.compile flags
  export NUMBA_CACHE_DIR=${NUMBA_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/numba}                    # upstream's featurizer caches its numba-compiled functions here instead of beside the package
fi
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1                                                                  # no .pyc in the kit tree; the kits' stderr lines arrive in order
