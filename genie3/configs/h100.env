# H100 deployment parameters (configs/a100.env is the A100's: this file with its target-GPU word). The mode is NOT here: it comes from `--mode` or GENIE3_OPT (default: the
# package's `modes.DEFAULT_MODE` — fast; GENIE3_OPT unset leaves the env route inert). usage: `run.sh design|check|warm --config h100
# --mode <mode> ...`, or `source configs/h100.env` before calling the package directly. Every value can be pre-set in the
# environment; this file fills what is unset and bakes no path. The deployment's two paths are read from the environment (STOCK.md Variables):
# GENIE3_ROOT — the editable Genie 3 checkout at the pin, the cwd of every line — and GENIE3_WEIGHTS — the directory holding
# checkpoints/step=600000.ckpt + config.yaml. Unset, the package resolves the checkout from pip's editable-install record of the `genie3`
# distribution and the weights from the stock layout <checkout>/pretrained/v1, and refuses by name when they do not resolve (`no Genie 3 checkout:
# set GENIE3_ROOT`; `weights missing (GENIE3_WEIGHTS=…)`). It refuses (rc 3) when genie3_opt is not importable on the `python` on PATH or the
# shared core it pins is absent / mismatched (the core pin gate: every route, the stock route included, goes through the package). Pinned stack:
# python 3.10, torch 2.7.1+cu126, cuDNN 9.5.1, triton 3.3.1, lightning 2.6.5, numpy 2.2.6 (stock/PINS.json "pinned_stack"; STOCK.md Stack).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this genie3/ directory (the package locates the kit and the stock pins through it)
python -c "import genie3_opt" 2>/dev/null || { echo "[genie3-opt] NOT ACTIVE: genie3_opt is not importable on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3; }
python -c "from genie3_opt._core import core_gate; core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                    # the core pin gate before any other probe: an absent / older / newer / edited shared core is its one NOT ACTIVE line, rc 3
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check reports a mismatch
[ -z "${GENIE3_ROOT:-}" ] || export GENIE3_ROOT                                                                    # the editable Genie 3 checkout at the pin — the cwd of every line (stock/PINS.json "install"; stock/check_pins.py refuses any other); no default: read from the environment, else pip's editable-install record
[ -z "${GENIE3_WEIGHTS:-}" ] || export GENIE3_WEIGHTS                                                              # the directory holding checkpoints/step=600000.ckpt + config.yaml (sha256 + source in stock/PINS.json "weights"); no default here: unset = the stock layout under the checkout, <checkout>/pretrained/v1 (genie3_opt/stack.py weights_dir)
# MODEL_OPT_STACK_KEY: the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g.
# torch2.7.1-cu126-sm90 (no kit kernel is JIT-compiled: the key names the stack in records). Computed once, refused by name if it fails.
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then
  _G3_STACK_KEY=$(python -c "from genie3_opt.stack import jit_cache_key; print(jit_cache_key())" 2>&1) || { echo "[genie3-opt] NOT ACTIVE: MODEL_OPT_STACK_KEY: jit_cache_key() failed on $(command -v python || echo 'python (not on PATH)'): $_G3_STACK_KEY" >&2; return 3 2>/dev/null || exit 3; }
  case "$_G3_STACK_KEY" in *unknown:*) echo "[genie3-opt] NOT ACTIVE: MODEL_OPT_STACK_KEY: $_G3_STACK_KEY" >&2; return 3 2>/dev/null || exit 3 ;; esac
  export MODEL_OPT_STACK_KEY="$_G3_STACK_KEY"
  unset _G3_STACK_KEY
else
  export MODEL_OPT_STACK_KEY
fi
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc written into the tree
