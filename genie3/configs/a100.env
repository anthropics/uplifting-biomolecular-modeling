# A100 deployment parameters (A100 80 GB and 40 GB, compute capability 8.0): configs/h100.env's parameters — the same variables, probes, refusals and
# JIT-cache keying (MODEL_OPT_STACK_KEY is derived from the running stack on either card: torch<version>-cu<CUDA>-sm80 here) — with this card's
# one value, the target-GPU word, set first. The mode is NOT here (`--mode` or GENIE3_OPT). usage: `run.sh design|check|warm --config a100
# --mode <mode> ...`, or `source configs/a100.env` before calling the package directly. The package classes the visible card by compute
# capability and memory band (genie3_opt.stack.GPU_CLASSES: class A100 = cc 8.0, 35-90 GiB, both cards) and check reports a mismatch with the word, never
# refuses; what depends on memory (the driver's capacity guard) reads the device it runs on, so the 40 GB card refuses a batch by name at smaller sizes.
# The fused triangle-multiplication lever (L7, mode fast's TriangleMultiplication provider) is served on this card by the `8.0|*` row of genie3_opt/fpf_cells.json (the
# shared core's fpf_trimul_v4 pointer-load cells, with C128/D128 tile overrides for this model's pair track); its census is the KERNELS line as
# on the H100 (CHANGES.md, L7). Mode exact does not plan L7.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0, class A100 of genie3_opt.stack.GPU_CLASSES); check reports a mismatch
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"                                                                            # keep this line last: configs/h100.env's refusals (its return codes) are this file's
