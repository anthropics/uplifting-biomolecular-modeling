# H200 (compute capability 9.0) deployment parameters; configs/a100.env is the A100 file of the same shape. The mode is NOT here: it comes from `--mode`, COLABFOLD_OPT or the
# package default (opt/colabfold_opt/modes.py DEFAULT_MODE); no lever switch (AF_PALLAS_ATTN*) is set here (the mode table is modes.py);
# the one cache variable is the XLA_CACHE lever's root. usage: `run.sh pred|check|warm
# --config h200 [--mode <mode>] ...`, or `source configs/h200.env` before calling the package directly. Every value can
# be pre-set in the environment; this file fills what is unset — except COLABFOLD_OPT_DATA_DIR, the parameters root, which has no default (unset: the file refuses by name, rc 2). It refuses (rc 2) when colabfold_opt is not installed on the `python` on
# PATH, and by name (rc 3, the package's NOT ACTIVE `core_missing:<module>` line) when the shared core behind it is absent — every route,
# the stock route included, goes through the package. The stack this tree runs on: the image in stock/PINS.json
# "image" (python 3.11.5, jax 0.5.3 + jax-cuda12-plugin 0.5.3, colabfold 1.6.1, alphafold-colabfold 2.3.13; environment/requirements.lock).
# The card: NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0 — the SAME capability key as the H100: every cell table, kernel row,
# prebuilt binary and lever of this kit is keyed by compute capability (or by the running stack), so this card reads EXACTLY the H100 entries — except
# JAX's persistent compile cache, which keys by device name: the H200's first run at a length compiles its own entries into the same tree;
# no memory gate is retuned (the card's larger memory is headroom, not a different plan).
# This file is configs/h100.env restated for the H200: every statement identical except the target-GPU word (and this file's own name in its
# messages); per-card differences from configs/h100.env — the complete list: NONE in any mode's lever set, kernel rows, size gates or refusals.
# The H200 uses the H100 settings; behaviour on the H100 is unchanged (this file is read only under --config h200).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this colabfold/ directory (the package locates the kit and the pins through it)
_cfo_probe_err=$(python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('colabfold_opt') else 4)" 2>&1 >/dev/null); _cfo_probe_rc=$?; case $_cfo_probe_rc in 0) ;; 4|126|127) echo "[colabfold-opt] NOT ACTIVE: colabfold_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2 ;; *) [ -n "$_cfo_probe_err" ] && printf '%s\n' "$_cfo_probe_err" >&2; return "$_cfo_probe_rc" 2>/dev/null || exit "$_cfo_probe_rc" ;; esac   # located, not imported: 'not installed' only when find_spec finds no colabfold_opt; any other rc is the interpreter's own start-up refusal (the autoload .pth under COLABFOLD_OPT=<mode>) — its words and its rc, nothing more exported
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                          # read from the package behind its core pin gate: an absent or another shared core is the NOT ACTIVE line (reason=core_missing:opt_core / core_mismatch / core_missing:<module>) and rc 3 here, never a silently unset key
  MODEL_OPT_STACK_KEY=$(python -c "import sys, colabfold_opt._autoload as a
a.gate_core()
try:
    from colabfold_opt.stack import stack_key
except ImportError as e:
    sys.exit(a.core_missing(e))
print(stack_key())") || { echo "[colabfold-opt] configs/h200.env: MODEL_OPT_STACK_KEY could not be read from the package (the line above); nothing more is exported" >&2; return 3 2>/dev/null || exit 3; }
fi
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0; the kit's tested class); every route notes a mismatch on its line (notes=...), none refuses
if [ -z "${COLABFOLD_OPT_DATA_DIR:-}" ]; then echo "[colabfold-opt] configs/h200.env: COLABFOLD_OPT_DATA_DIR is not set — the AlphaFold2 parameters root passed to colabfold_batch as --data (<root>/params/params_model_{1..5}_multimer_v3.npz + params/download_complexes_multimer_v3_finished.txt; stock/PINS.json \"weights\", README 'Variables'); nothing more is exported" >&2; return 2 2>/dev/null || exit 2; fi
export COLABFOLD_OPT_DATA_DIR                                                                                        # the parameters root, passed to colabfold_batch as `--data`: <root>/params/params_model_{1..5}_multimer_v3.npz + the marker file (stock/PINS.json "weights"); nothing is fetched at run time when they are present
export MODEL_OPT_STACK_KEY=${MODEL_OPT_STACK_KEY}                                                                   # jax<version>-cu<CUDA runtime major.minor>-sm<compute capability>, e.g. jax0.5.3-cu12.9-sm90: the key under which the XLA_CACHE lever places JAX's compile cache
export COLABFOLD_OPT_JIT_ROOT=${COLABFOLD_OPT_JIT_ROOT:-${HOME:-/root}/.cache/colabfold_opt/jit}                    # the compile-cache root of the XLA_CACHE lever (<root>/<stack key>/<recipe>/jax, recipe = det | default from the caller's XLA_FLAGS); a JAX_COMPILATION_CACHE_DIR already set is kept instead; box-local by default — point it at a persistent disk to keep executables across boxes
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
