# H200 deployment parameters (NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0): configs/h100.env's variables, probes
# and refusals, with this card's target-GPU word and memory total set first. H200 uses the H100 settings; behaviour on H100 is unchanged
# (this file is read only under --config h200). Usage: `run.sh <verb> --config h200 --mode <mode> ...`, or `source configs/h200.env`.
# No mode's lever set differs per card; the two words below name the card the check / activation lines compare (another card is reported
# as match=no, never refused).
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0); check/design print target=/match= and record it
export MODEL_OPT_TARGET_GPU_MEM_MIB=${MODEL_OPT_TARGET_GPU_MEM_MIB:-143771}                                          # the memory total the match asserts (nvidia-smi MiB): 143771 = NVIDIA H200 (141 GB)
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"                                                                            # keep this line last: configs/h100.env's refusals (its return codes) are this file's
