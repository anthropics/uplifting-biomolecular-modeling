# proteinmpnn/configs/a100.env — deployment parameters for one A100 box (compute capability 8.0: A100-SXM4-80GB, A100 80GB PCIe, A100 40GB):
# configs/h100.env's parameters — the same variables, probes and refusals — with this card's two values set first, the target-GPU word and the
# memory total the match asserts (the 80 GB parts' by default). The modes, the levers (`--bb_batch 16` included) and the worker's start-up probe are
# the same on every A100; only the memory ceiling differs with the part. On an A100 40GB set MODEL_OPT_TARGET_GPU_MEM_MIB=40960 before sourcing so
# that `match=` asserts that part (left at 81920 the activation line reports match=no there — a report, never a refusal).
# `source` it (run.sh --config a100 does) before running any mode; the mode itself is never set here (`--mode` or PROTEINMPNN_OPT). The kit
# keys no compile cache of its own: the CUDA graphs are captured per process; the worker's one Triton kernel lands in Triton's own cache.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0); check/design print target=/match= and record it
export MODEL_OPT_TARGET_GPU_MEM_MIB=${MODEL_OPT_TARGET_GPU_MEM_MIB:-81920}                                           # the memory total the match asserts (nvidia-smi MiB): 81920 = A100-SXM4-80GB / A100 80GB PCIe; an A100 40GB reports 40960 — set that value there
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"                                                                            # keep this line last: configs/h100.env's refusals (its return codes) are this file's
