# proteinmpnn/configs/h100.env — deployment parameters for one H100 80GB box (configs/a100.env is the A100 80GB's: this file with its target-GPU word and memory total). `source` it (run.sh --config h100 does) before running any mode; it carries
# no mode and no lever switch (those live in opt/proteinmpnn_opt/modes.py only). Every value can be pre-set in the environment; this file fills what is unset —
# except the data path MPNN_DIR, which has no default (STOCK.md 'Variables'): unset, a route that needs it refuses by name (NOT ACTIVE, rc 3).
# Its first two lines of work are the probes of every route: NOT ACTIVE (rc 3) when proteinmpnn_opt is not importable on the `python` on PATH (every route,
# the stock route included, goes through the package), then the core pin gate (proteinmpnn_opt.core_gate: a shared core absent or older than the kit's pin is
# its one NOT ACTIVE line, rc 3, before anything of the core is imported).
# Pinned stack: python 3.11, torch 2.5.1+cu124, numpy 1.26.4 (stock/PINS.json "pinned_stack").
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this proteinmpnn/ directory (the package locates opt/forward and stock/ through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check/design print target=/match= and record it
export MODEL_OPT_TARGET_GPU_MEM_MIB=${MODEL_OPT_TARGET_GPU_MEM_MIB:-81559}                                            # the class's memory total (nvidia-smi MiB, H100 80GB HBM3): the match asserts it, so an H100 NVL (95830) is not a match
[ -z "${MPNN_DIR:-}" ] || export MPNN_DIR                                                                            # variants soluble / vanilla: your ProteinMPNN clone (stock/PINS.json "upstream" names the pinned commit; its .git names the commit in the .fa headers) with the repository weights — no default
python -c "import proteinmpnn_opt" 2>/dev/null || { echo "[proteinmpnn-opt] NOT ACTIVE: proteinmpnn_opt is not installed on $(command -v python || echo 'python (not on PATH)'): $MODEL_OPT/run.sh install (= pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt)" >&2; return 3 2>/dev/null || exit 3; }
python -c "from proteinmpnn_opt import core_gate; core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                    # the core pin gate before any other probe: a shared core absent or older than the kit's pin is its one NOT ACTIVE line, rc 3; any core at or above the pin activates
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree or the checkout
