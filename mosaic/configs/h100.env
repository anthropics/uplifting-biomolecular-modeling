# H100 deployment parameters (H100 80GB, compute capability 9.0; configs/a100.env is the A100 file). The mode is NOT here: it comes from `--mode` or MOSAIC_OPT=<mode> (fast|exact|big|off).
# usage: `run.sh design|check|warm --config h100 --mode <mode> ...`, or `source configs/h100.env` before calling the package directly.
# Every value can be pre-set in the environment; this file fills what is unset — except the two data paths, which it never invents: MOSAIC_CACHE_DIR (the weights cache) and MOSAIC_OPT_CACHE_ROOT (the P1 files' root) come from the caller's environment (STOCK.md "Variables"); unset, the package refuses by name. It refuses (rc 3, the NOT ACTIVE line) when mosaic_opt is
# not importable on the `python` on PATH, when its core pin gate refuses (`mosaic_opt.core_gate`, before any other probe: an absent or older shared
# core; a newer core passes) or when the P1 key cannot be derived (every route, the stock route included, goes through the package). Pinned stack: python 3.12, jax 0.10.2
# + jax-cuda12-plugin 0.10.2, torch 2.7.1+cpu, no Triton (stock/PINS.json "pinned_stack" and "pins").
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this mosaic/ directory (the package locates the kit through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check/design note a mismatch
# MOSAIC_CACHE_DIR       — from the environment (STOCK.md "Variables"): the library's weights cache root (src/mosaic/cache.py), <root>/boltz/boltz2_conf.ckpt + <root>/boltz/mols/ (sha256 in stock/PINS.json "weights"); staged by `run.sh warm` when the checkpoint is absent; design / check / warm refuse by name when it is unset
MOSAIC_OPT= python -c "import mosaic_opt" 2>/dev/null || { echo "[mosaic-opt] NOT ACTIVE: mosaic_opt is not importable on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3; }   # importability alone (the mode variable neutralised for this probe: an installed .pth gates at interpreter start under MOSAIC_OPT; the gate speaks once, on the next line)
python -c "from mosaic_opt import core_gate; core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                    # the core pin gate before any other probe: an absent / older / newer / edited shared core is its one NOT ACTIVE line, rc 3
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then
  MODEL_OPT_STACK_KEY=$(python -c "from mosaic_opt.modes import jit_cache_key; print(jit_cache_key())") || { echo "[mosaic-opt] NOT ACTIVE: jit_cache_key failed on $(command -v python || echo 'python (not on PATH)') (jax not installed, or no GPU visible -- see the traceback above): MODEL_OPT_STACK_KEY cannot be derived; set it explicitly to override" >&2; return 3 2>/dev/null || exit 3; }
fi
export MODEL_OPT_STACK_KEY   # the P1 files' key jax<version>-jaxlib<version>-cuda12plugin<version>-<GPU product name> (opt_core.jax_design.pcc.key), e.g. jax0.10.2-jaxlib0.10.2-cuda12plugin0.10.2-nvidia-h100-80gb-hbm3 (one set per image + GPU type)
# MOSAIC_OPT_CACHE_ROOT  — from the environment (STOCK.md "Variables"): the P1 files per shape, <root>/<shape>/xla_cache/ (compilation cache + xla_autotune_results.pb) and <root>/<shape>/features_<shape>.npz (frozen features); persistent, one root per MODEL_OPT_STACK_KEY (the running jax + plugin + GPU type); when it is unset and the optional shared JIT cache root MODEL_OPT_JIT_ROOT is set, it is <MODEL_OPT_JIT_ROOT>/<MODEL_OPT_STACK_KEY>/mosaic (below); with neither, the kit modes and `warm` refuse by name
if [ -z "${MOSAIC_OPT_CACHE_ROOT:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then export MOSAIC_OPT_CACHE_ROOT=$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/mosaic; fi   # the optional shared JIT cache root (STOCK.md "Variables"): one keyed directory per stack under it; an explicit MOSAIC_OPT_CACHE_ROOT wins
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc written into the tree
