# configs/h100.env — deployment parameters of an H100 box, sourced by `run.sh --config h100` (or by hand before `python -m esm_if1_opt`).
# Nothing here selects a mode, a sampling value or a seed; every variable keeps a value already set in the environment.
export MODEL_OPT="${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"      # the esm_if1/ directory (run.sh exports it too)
export MODEL_OPT_TARGET_GPU="${MODEL_OPT_TARGET_GPU:-H100}"                              # `check` prints target= / match= against the probed GPU; never a gate
export MODEL_OPT_STATE="${MODEL_OPT_STATE:-${HOME:-/root}/.cache/esm_if1_opt}"          # state directory (holds torch_home/ unless TORCH_HOME is set)
export TORCH_HOME="${TORCH_HOME:-$MODEL_OPT_STATE/torch_home}"                          # torch.hub's cache root: upstream's loader reads hub/checkpoints/esm_if1_gvp4_t16_142M_UR50.pt here and downloads it when absent;
                                                                                         # with ESM_IF1_WEIGHTS=<local copy of that file> `design` links the cache entry to it first (no download)
export PYTHONDONTWRITEBYTECODE=1
