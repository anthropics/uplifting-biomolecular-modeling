# configs/a100.env — deployment parameters of an A100 box, the 80 GB or the 40 GB card: the H100 file with the target GPU class A100 — same modes,
# same lines; the card's memory only bounds how large a --batch_size fits a backbone length (README, Notes).
export MODEL_OPT_TARGET_GPU="${MODEL_OPT_TARGET_GPU:-A100}"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/h100.env"
