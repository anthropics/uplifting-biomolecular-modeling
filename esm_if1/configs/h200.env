# configs/h200.env — deployment parameters of an H200 box (the 141 GB card, compute capability 9.0): the H100 file with the target GPU class
# H200 — same modes, same lines; the card's memory only bounds how large a --batch_size fits a backbone length (README, Notes). This file is
# read only under --config h200 (`run.sh <verb> --config h200 …` or `source configs/h200.env`); behaviour under --config h100 is unchanged.
export MODEL_OPT_TARGET_GPU="${MODEL_OPT_TARGET_GPU:-H200}"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/h100.env"
