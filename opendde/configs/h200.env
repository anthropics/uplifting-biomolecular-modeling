# H200 deployment parameters. The mode is NOT here: it comes from `--mode` or from OPENDDE_OPT;
# no lever switch is set in this file (the mode table is opt/opendde_opt/modes.py). usage:
# `run.sh pred|check|warm --config h200 [--mode <mode>] ...`, or `source configs/h200.env` before calling the package
# directly. Every value can be pre-set in the environment; this file fills what is unset (no mount path is assumed:
# STOCK.md "Variables"). It refuses (rc 2) when
# opendde_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package).
# Pinned stack: python 3.11, opendde 1.1.1, torch 2.7.1+cu126, triton 3.3.1, cuequivariance* 0.10.0, CUDA 12.6 (stock/PINS.json "pinned_stack"; STOCK.md "Install").
# The card: NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0 — the SAME capability key as the H100: every cell table, kernel row,
# prebuilt binary and lever of this kit is keyed by compute capability (or by the running torch/CUDA stack), so this card reads EXACTLY the H100 entries;
# no memory gate is retuned (the card's larger memory is headroom, not a different plan).
# This file is configs/h100.env restated for the H200: every statement identical except the target-GPU word (and this file's own name in its
# messages); per-card differences from configs/h100.env — the complete list: NONE in any mode's lever set, kernel rows, size gates or refusals.
# The H200 uses the H100 settings; behaviour on H100 is unchanged (this file is read only under --config h200).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this opendde/ directory (the package locates the kits through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0; the shipped tuned-tile cache file is the sm_90 key)
export MODEL_OPT_BIG_OFFLOAD_MIN_TOKENS=${MODEL_OPT_BIG_OFFLOAD_MIN_TOKENS:-1400}                                    # big's offload size gate (opt/opendde_opt/big.py size_gate_policy): the offload unit installed (pair_offload ON: the pair tensors host-resident, and sample_chunk with it) when the largest input item counts >= this many residue tokens; below it (OFF) `--mode big` runs fast's resident lever set on its fixed allocator — decided by the package from the query (polymer residues: a floor — ligand atoms are not counted, an under-count keeps the unit on), no variable overrides it; 1400 = fast's resident envelope on this 80 GB card (its peak memory under stock's up to it)
export MODEL_OPT_BIG_NO_DIT_HOIST_MIN_TOKENS=${MODEL_OPT_BIG_NO_DIT_HOIST_MIN_TOKENS:-2565}                          # big's DiT-hoist size gate (opt/opendde_opt/big.py size_gate_policy): the DITFAST hoist left out (no_dit_hoist ON) when the largest input item counts >= this many residue tokens, kept below (OFF) — decided by the package from the query, no variable overrides it; 2565 = the largest input size known to fit WITH the hoist on this 80 GB card on the offload line (the next size up does not)
export MODEL_OPT_SMALL_INPUT_FLOOR_TOKENS=${MODEL_OPT_SMALL_INPUT_FLOOR_TOKENS:-300}                              # the small-input floor of the exact and fast lines (opt/opendde_opt/smalln.py): when EVERY item of a pred call counts fewer residue tokens than this, the trunk levers (arm_z | arm_u + arm_u23, fpf_trimul_exact) and the provider bindings that ride them (triattn_core|exact|conf, trimul_core|exact, transition_core|exact, ln_core) are composed out of the line (smalln.FLOOR_LEVERS) — below ARM's own 300-token design gate the trunk kernels are stock anyway and the binds can only cost host time; one item at or above the floor keeps the whole line; 0 = bound at every size; a value that is not a non-negative integer is refused by name
# OPENDDE_ROOT_DIR — the weights root (checkpoint/opendde.pt, sha256 in stock/PINS.json "checkpoint", + common/ CCD files) — is read from the environment and has no
# default here: pred and warm refuse by name ("OPENDDE_ROOT_DIR is not set — see README Variables") when it is unset.
_PROBE_ERR=$(python -m opendde_opt help 2>&1 >/dev/null) || {                   # the REAL entry, before any probe below: the package's own NOT ACTIVE line and exit code pass through; this file stops there
  _rc=$?; [ -n "$_PROBE_ERR" ] && printf '%s\n' "$_PROBE_ERR" >&2
  if printf '%s' "$_PROBE_ERR" | grep -qE "No module named '?opendde_opt"; then
    echo "[opendde-opt] NOT ACTIVE: reason=opendde_opt is not installed on $(command -v python || echo 'python (not on PATH)') (pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt)" >&2; _rc=3
  fi
  unset _PROBE_ERR; return "$_rc" 2>/dev/null || exit "$_rc"
}
unset _PROBE_ERR
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -c "from opendde_opt.modes import jit_cache_key; print(jit_cache_key())") || { echo "[opendde-opt] NOT ACTIVE: the stack-key probe (opendde_opt.modes.jit_cache_key) failed on this python — its error is the line above" >&2; return 3 2>/dev/null || exit 3; }; fi
export MODEL_OPT_STACK_KEY                                                                                              # torch<version sans local tag>-cu<CUDA sans dot>-sm<capability>, e.g. torch2.7.1-cu126-sm90 (`unknown` only when torch reports no CUDA build)
# MODEL_OPT_JIT_ROOT — the JIT/compile-cache root (STOCK.md "Variables"): the caches are keyed under it, <root>/<stack key>/{triton,torch_ext}, and the
# weights digest memo is <root>/weights, so every process after the first on this root starts on compiled Triton kernels, the built fused-LayerNorm
# extension and a memoised digest instead of redoing them. Default: the per-user cache directory (${XDG_CACHE_HOME:-$HOME/.cache}/opendde_opt); a
# shared writable path shares the caches between users or containers. A pre-set MODEL_OPT_JIT_ROOT / TRITON_CACHE_DIR / TORCH_EXTENSIONS_DIR /
# MODEL_OPT_WEIGHTS_DIGEST_DIR is kept.
export MODEL_OPT_JIT_ROOT=${MODEL_OPT_JIT_ROOT:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/opendde_opt/jit}                # the cache root (per user by default)
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}                            # Triton JIT cache (cuEquivariance TriMul, the ARM-T kernels), keyed by the running torch+CUDA+arch
export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_ext}                 # torch C++ extension cache (upstream's fast_layer_norm build), same key
export MODEL_OPT_WEIGHTS_DIGEST_DIR=${MODEL_OPT_WEIGHTS_DIGEST_DIR:-$MODEL_OPT_JIT_ROOT/weights}                        # the checkpoint digest memo (opt/opendde_opt/manifest.py digest_memo_dir)
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
