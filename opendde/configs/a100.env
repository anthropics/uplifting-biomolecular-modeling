# A100 (the 80 GB or the 40 GB card, compute capability 8.0) deployment parameters — configs/h100.env's shape less big's two size gates, which the package sizes by the running card (4. below). The mode is NOT here: it comes from `--mode` or from OPENDDE_OPT;
# no lever switch is set in this file (the mode table is opt/opendde_opt/modes.py). usage:
# `run.sh pred|check|warm --config a100 [--mode <mode>] ...`, or `source configs/a100.env` before calling the package
# directly. Every value can be pre-set in the environment; this file fills what is unset (no mount path is assumed:
# STOCK.md "Variables"). It refuses (rc 2) when
# opendde_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package).
# Pinned stack: python 3.11, opendde 1.1.1, torch 2.7.1+cu126, triton 3.3.1, cuequivariance* 0.10.0, CUDA 12.6 (stock/PINS.json "pinned_stack"; STOCK.md "Install").
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this opendde/ directory (the package locates the kits through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0: the sm_80 tile rows are selected by the running device, not by this label)
export MODEL_OPT_SMALL_INPUT_FLOOR_TOKENS=${MODEL_OPT_SMALL_INPUT_FLOOR_TOKENS:-300}                              # the small-input floor of the exact and fast lines (opt/opendde_opt/smalln.py): when EVERY item of a pred call counts fewer residue tokens than this, the trunk levers (arm_z | arm_u + arm_u23, fpf_trimul_exact) and the provider bindings that ride them (triattn_core|exact|conf, trimul_core|exact, transition_core|exact, ln_core) are composed out of the line (smalln.FLOOR_LEVERS) — below ARM's own 300-token design gate the trunk kernels are stock anyway and the binds can only cost host time; one item at or above the floor keeps the whole line; 0 = bound at every size; a value that is not a non-negative integer is refused by name
# Per-card differences from configs/h100.env — the complete list; anything not named here runs the identical code path and lever set as on H100:
#   1. Triangle attention (levers triattn_core / triattn_exact, the same tier words as on H100) is the core provider's row per cell of ITS table for
#      compute capability 8.0 (opt_core.kernels.triattn TRIATTN_CELLS.json: the row and its launch setting per dtype / heads / row count; the LEVER line
#      names the row served per cell) — the kit carries no attention kernel, tile row or row floor of its own on either card.
#   2. No tile row, kernel copy or row floor is carried kit-side on either card: the TriMul rows (levers trimul_core / trimul_exact) and the
#      triangle-attention rows (triattn_core / triattn_exact) are the core providers' per-card cells (opt_core.kernels.trimul / .triattn), the row
#      served per cell named on the LEVER lines.
#   3. No cuEquivariance tile table is shipped on any card: the kit lines export the tuning-cache location levers/KIT/cueq_cache_shipped (an optional
#      user cache) and, absent a user file there, cuEquivariance's own packaged per-card cache serves (8.0 here, 9.0 on H100) -- identical on both cards.
#   3a. The TriMul provider (levers trimul_core / trimul_exact, the same words as on H100; ARM U's route arm_u23 hands it every admitted call) selects its rows by
#      the running device from the core's cell table (opt_core.kernels.trimul TRIMUL_CELLS) at every row count: the exact word serves the rows the table vouches
#      bit-identical on the 8.0 stack (native_exact at c_z 384) and the stock op by name where no row is vouched (today the template stack's c_z 64 and the
#      fp32/TF32 refiner calls); fast / big serve the measured winner per cell. The kit carries no TriMul kernel or tile table.
#   3b. The triangle-attention provider (levers triattn_core / triattn_exact, the same words as on H100) selects its rows by the running device from the
#      core's cell table: on 8.0 the fast word serves the k2b row at the core's 8.0 cell (the BLOCK_M 128 / BLOCK_N 32 / ROWS=2 tile of 2. above; a cell
#      without a launch setting takes the kit row, LEVER token k2b_cell=sm_80:...); the provider's sm_90-only rows (the sealed CUDA package serving its big tier on H100 and the sm_90a CUDA row) refuse
#      `arch:sm_80` by name, and the exact word serves the per-head route above 400 rows (the stock kernel at and below).
#   3c. The sampler step-graph (lever stepgraph, exact / fast) carries an sm_80 row (opendde_opt.stepgraph.CARD_ROWS['80'] = 1,024 tokens):
#      on this card the captured denoiser step's replay is bit-exact to the eager step up to that size and not above it,
#      so above 1,024 residue tokens the line composes it out BY NAME (LEVER state=off reason=card_gate:sm80_replay_not_bit_exact_above:1024);
#      nothing is exported for it here.
#   4. big's two size gates (MODEL_OPT_BIG_OFFLOAD_MIN_TOKENS, MODEL_OPT_BIG_NO_DIT_HOIST_MIN_TOKENS) are not exported here: the package sizes them
#      by the running card (opt/opendde_opt/big.py gate_default — device 0's total memory as opendde_opt.stack.gpu_info reads it, nvidia-smi memory.total):
#      under 64 GiB — the 40 GB card (40960 MiB) — 1160 (fast's resident lever set holds a 1,152-token input there and not a 1,216-token one) and 1856 (computed
#      from the hoist's 1536·N² resident bytes); the 80 GB card, a box with no GPU visible and a failed probe get configs/h100.env's 1400 and 2565.
#      A value set in the environment wins, as for every variable here.
# OPENDDE_ROOT_DIR — the weights root (checkpoint/opendde.pt, sha256 in stock/PINS.json "checkpoint", + common/ CCD files) — is read from the environment and has no
# default here: pred and warm refuse by name ("OPENDDE_ROOT_DIR is not set — see README Variables") when it is unset.
_PROBE_ERR=$(python -m opendde_opt help 2>&1 >/dev/null) || {                   # the REAL entry, before any probe below: the package's own NOT ACTIVE line and exit code pass through; this file stops there
  _rc=$?; [ -n "$_PROBE_ERR" ] && printf '%s\n' "$_PROBE_ERR" >&2
  if printf '%s' "$_PROBE_ERR" | grep -qE "No module named '?opendde_opt"; then
    echo "[opendde-opt] NOT ACTIVE: reason=opendde_opt is not installed on $(command -v python || echo 'python (not on PATH)') (pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt)" >&2; _rc=3
  fi
  unset _PROBE_ERR; return "$_rc" 2>/dev/null || exit "$_rc"
}
unset _PROBE_ERR
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -c "from opendde_opt.modes import jit_cache_key; print(jit_cache_key())") || { echo "[opendde-opt] NOT ACTIVE: the stack-key probe (opendde_opt.modes.jit_cache_key) failed on this python — its error is the line above" >&2; return 3 2>/dev/null || exit 3; }; fi
export MODEL_OPT_STACK_KEY                                                                                              # torch<version sans local tag>-cu<CUDA sans dot>-sm<capability>, e.g. torch2.7.1-cu126-sm90 (`unknown` only when torch reports no CUDA build)
# MODEL_OPT_JIT_ROOT — the JIT/compile-cache root (STOCK.md "Variables"): the caches are keyed under it, <root>/<stack key>/{triton,torch_ext}, and the
# weights digest memo is <root>/weights, so every process after the first on this root starts on compiled Triton kernels, the built fused-LayerNorm
# extension and a memoised digest instead of redoing them. Default: the per-user cache directory (${XDG_CACHE_HOME:-$HOME/.cache}/opendde_opt); a
# shared writable path shares the caches between users or containers. A pre-set MODEL_OPT_JIT_ROOT / TRITON_CACHE_DIR / TORCH_EXTENSIONS_DIR /
# MODEL_OPT_WEIGHTS_DIGEST_DIR is kept.
export MODEL_OPT_JIT_ROOT=${MODEL_OPT_JIT_ROOT:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/opendde_opt/jit}                # the cache root (per user by default)
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}                            # Triton JIT cache (cuEquivariance TriMul, the ARM-T kernels), keyed by the running torch+CUDA+arch
export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_ext}                 # torch C++ extension cache (upstream's fast_layer_norm build), same key
export MODEL_OPT_WEIGHTS_DIGEST_DIR=${MODEL_OPT_WEIGHTS_DIGEST_DIR:-$MODEL_OPT_JIT_ROOT/weights}                        # the checkpoint digest memo (opt/opendde_opt/manifest.py digest_memo_dir)
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
