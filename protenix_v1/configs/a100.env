# A100 (compute capability 8.0; the 80 GB and the 40 GB card alike: admission is by capability and every memory-dependent limit is read from the
# running device, never from the class name) deployment parameters: the same variables as configs/h100.env; only the card label differs. The mode is NOT
# here: it comes from `--mode` or PROTENIX_V1_OPT.
# usage: `run.sh pred|check|warm --config a100 --mode <mode> ...`, or `source configs/a100.env` before calling the package or
# `protenix pred` directly. Every value can be pre-set in the environment; this file fills what is unset — except PROTENIX_ROOT_DIR, the
# weights + data root, which has no default: unset, it refuses by name (rc 3). It refuses (rc 2) when
# protenix_v1_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package). Pinned
# stack (environment/Dockerfile + requirements.lock): python 3.11, torch 2.13.0+cu130, triton 3.7.1, cuequivariance 0.11.1, protenix 1.1.0.
# Per-card differences from configs/h100.env: on compute capability 8.0 `exact`'s `dit_attn_exact` (its DiT attention kernel has no sm_80 prebuilt)
# and the fused sampler stacks `cond_dedupe`, `dit_fused`, `dit_lowp`, `atom_fused` (sm_90 cells only) step aside by name (`LEVER … state=skipped
# reason=card_off`; the stock statements serve, exit 0), and `atom_attn_exact` steps aside where the shared core's exact word names the stock kernel
# (`reason=aside`). The shared core's compute-capability-8.0 kernel rows serve the other levers (other tiles, same kernels, same numerics class). `exact`'s two bit-equal-class pair levers — the fused triangle-attention block (`gblock`) and the fused pair transition (`xtr`) —
# have a served row range on this card (the shared core's exact_rows rule): a call outside it goes to the stock forward by name (`min_rows=<n>
# max_rows=<n> range=<served|range-off>` + `gated_by=stock:below_min_rows:<k>|stock:above_max_rows:<k>` on the LEVER line), because the stock
# projections' cuBLAS summation order changes with the row count outside those ranges on this card; `exact` stays bitwise to `--mode off` at every
# size. STOCK.md and CHANGES.md hold the per-card detail.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this protenix_v1/ directory (the package locates the kit through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0, admitted by capability); check/pred report the running one beside it
export LAYERNORM_TYPE=${LAYERNORM_TYPE:-fast_layernorm}                                                              # the stock fast LayerNorm path (the upstream default; the kit's sg lever needs its stream-correct build, which the kit installs)
_PTX1_EXT_PRESET=${TORCH_EXTENSIONS_DIR:-}; _PTX1_TRITON_PRESET=${TRITON_CACHE_DIR:-}                                            # the caller's own cache directories, if any (kept over the keyed ones below)
if [ -z "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                             # no cache root named (run.sh names one on every route; a shell that sources this file itself may not): the per-user root under the temporary
  MODEL_OPT_JIT_ROOT="${TMPDIR:-/tmp}/model_opt_jit-uid$(id -u)"                                                     # directory — made here with mode 0700, or made so by an earlier run of this user; never a fixed name every account on the machine shares:
  mkdir -p "${MODEL_OPT_JIT_ROOT%/*}" 2>/dev/null || :; mkdir -m 700 "$MODEL_OPT_JIT_ROOT" 2>/dev/null || :          # the extension builds (.so) and Triton binaries cached under it are loaded as found
  _PTX1_OWN=""; if [ -d "$MODEL_OPT_JIT_ROOT" ] && [ ! -L "$MODEL_OPT_JIT_ROOT" ] && [ -O "$MODEL_OPT_JIT_ROOT" ]; then case $(stat -c %a "$MODEL_OPT_JIT_ROOT" 2>/dev/null) in ''|*[2367]|*[2367]?) ;; *) _PTX1_OWN=1 ;; esac; fi   # another owner, a group / other write bit, a symbolic link, or not creatable: refused
  if [ -z "$_PTX1_OWN" ]; then
    _PTX1_OWN=$(mktemp -d "${TMPDIR:-/tmp}/protenix_v1_jit-XXXXXXXX") || { echo "[protenix-v1-opt] NOT ACTIVE: no private cache directory can be made under ${TMPDIR:-/tmp} — set MODEL_OPT_JIT_ROOT to a directory of your own" >&2; return 3 2>/dev/null || exit 3; }
    echo "[protenix-v1-opt] jit cache: $MODEL_OPT_JIT_ROOT refused (another owner, open to group or others, a symbolic link, or not creatable) — nothing in it is loaded; this run compiles privately in $_PTX1_OWN" >&2
    MODEL_OPT_JIT_ROOT=$_PTX1_OWN
  fi
  export MODEL_OPT_JIT_ROOT; unset _PTX1_OWN
fi
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
export PYTHONUNBUFFERED=1
bash "$MODEL_OPT/run.sh" probe || { rc=$?; return $rc 2>/dev/null || exit $rc; }                          # the package probe (run.sh probe_package, the one definition): an absent protenix_v1_opt is `NOT ACTIVE: … is not installed …` rc 2; a refusal at interpreter start or while importing (an undeclared PROTENIX_V1_OPT* name, an unknown mode) keeps python's own line and exit code
python -m protenix_v1_opt._producers || { return 3 2>/dev/null || exit 3; }                                  # the producers gate (_producers.py): the shared core present with every module this package imports, else `NOT ACTIVE: reason=core_missing:opt_core | producer_missing:<modules> …` rc 3 before any probe below imports the package
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -m protenix_v1_opt._stackkey) || { rc=$?; echo "[protenix-v1-opt] NOT ACTIVE: the JIT cache key probe (python -m protenix_v1_opt._stackkey) exited $rc — its words above" >&2; return $rc 2>/dev/null || exit $rc; }; fi; export MODEL_OPT_STACK_KEY   # the running torch + CUDA + compute capability (torch2.13.0-cu130-sm90 on the pinned stack); `unknown` when a part cannot be established — the caches below are keyed <root>/<stack key>/{torch_extensions,triton} by it under the root named by the caller, by run.sh, or the per-user one above
export TORCH_EXTENSIONS_DIR=${_PTX1_EXT_PRESET:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}      # a first run on a new stack fills both caches once (the Triton kernels; the stream-correct fast-LN build only where the shipped prebuilt does not match the stack);
export TRITON_CACHE_DIR=${_PTX1_TRITON_PRESET:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}                        # every later process and container that mounts the same root reuses them
unset _PTX1_EXT_PRESET _PTX1_TRITON_PRESET
[ -n "${PROTENIX_ROOT_DIR:-}" ] || { echo "[protenix-v1-opt] NOT ACTIVE: PROTENIX_ROOT_DIR is not set — the weights + data root the upstream reads: <root>/checkpoint/protenix_base_default_v1.0.0.pt + <root>/common/ (stock/PINS.json \"stock\")" >&2; return 3 2>/dev/null || exit 3; }
export PROTENIX_ROOT_DIR="$PROTENIX_ROOT_DIR"                                                                         # weights + data cache root (no default): checkpoint/protenix_base_default_v1.0.0.pt, common/{components.cif, components.cif.rdkit_mol.pkl, clusters-by-entity-40.txt, obsolete_release_date.csv} (stock/PINS.json "stock"); nothing is fetched at run time when they are present
python -c "from protenix_v1_opt import kit; kit.frozen_weights_main()" || { return 3 2>/dev/null || exit 3; }   # the frozen-weights boot gate: the weights root carries the pinned checkpoint + data caches, else NOT ACTIVE rc 3 (the upstream would download them silently: runner/inference.py:291-347)
