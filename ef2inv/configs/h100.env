# ef2inv — deployment parameters for one H100 machine on the pinned stack (STOCK.md §Stack; stock/PINS.json "pinned_stack").
# Sourced by run.sh --config h100 (set -a). Deployment only: no lever, no mode, no setting lives here, and no data path: the weights root
# (HF_HOME), the stock cookbook file (EF2INV_COOKBOOK_STOCK, else the installed esm checkout's) and the optional shared JIT-cache root
# (MODEL_OPT_JIT_ROOT) are the operator's variables — STOCK.md §Variables; a verb that needs one that is unset refuses by its name.
MODEL_OPT="${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
EF2INV_REQUIRE_FAST_ENV="${EF2INV_REQUIRE_FAST_ENV:-1}"                # the pinned stack's fast environment (stock/PINS.json pinned_stack: flash_attn, transformer_engine, xformers): every route
                                                                       # compares the attention / MLP paths it binds with opt/ef2inv_opt/attention.py FAST_ENV and NAMES any difference on one info line, every mode alike (esmc_rope=torch exempt
                                                                       # under --upstream-fix EF2INV-0003); the run proceeds, levers engaged — read by the CLI, never by an arm; 0 = the words report what is bound without the comparison
HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"                     # nothing is fetched at run time (the six snapshots are already under HF_HOME: STOCK.md §Weights)
PYTHONDONTWRITEBYTECODE="${PYTHONDONTWRITEBYTECODE:-1}"               # no .pyc in a mounted tree
# The JIT cache switch — EF2INV_JIT_CACHE=shared|per-box (opt/ef2inv_opt/modes.py jit_cache_dirs; `run.sh check` refuses a switch and dirs that disagree):
#   shared  (default) $MODEL_OPT_JIT_ROOT/<stack key>/{triton,inductor}, a cache directory kept across runs (and shareable between machines) — a SPEED lever and a
#           state channel between runs (kernel / autotune choices written by one run are read by the next).
#           MODEL_OPT_JIT_ROOT is optional and has no default: unset (and the switch unset), nothing is exported — Triton
#           and Inductor use their own default dirs and the run lines say cache=unset; EF2INV_JIT_CACHE=shared set explicitly without it is
#           refused by name;
#   per-box a private root (EF2INV_JIT_LOCAL_ROOT, else a fresh ${TMPDIR:-/tmp}/ef2inv-jitcache-XXXXXXXX made by `mktemp -d`, mode 0700) — the DET-ARM form: nothing read from or written to
#           the shared root. The launcher applies per-box to every `--det >= 1` arm by itself when this switch is unset;
#   frozen:<sha256> (a read-only cache artifact cited by sha) is a named form this tree does not ship — refused.
case "${EF2INV_JIT_CACHE:-shared}" in
  shared)  if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then
             _EF2INV_JIT_ROOT="${MODEL_OPT_JIT_ROOT%/}/${EF2INV_JIT_KEY:-torch2.11.0-cu128-sm90}"      # keyed by the pinned stack on this card (torch<v>-cu<cuda>-sm<cc>; another card's config sets EF2INV_JIT_KEY from its compute capability, configs/a100.env); `check` refuses a shared dir not keyed by the running stack (opt_core.jit_cache)
           elif [ -n "${EF2INV_JIT_CACHE:-}" ]; then
             echo "configs/h100.env: MODEL_OPT_JIT_ROOT is not set — see README.md §Variables (EF2INV_JIT_CACHE=shared needs the shared JIT-cache root, <root>/<stack key>/{triton,inductor}; or EF2INV_JIT_CACHE=per-box for a private cache)" >&2
             return 2 2>/dev/null || exit 2
           else
             _EF2INV_JIT_ROOT=""                                                   # no shared root named: nothing exported below — Triton / Inductor keep their own defaults (cache=unset on the run lines)
           fi ;;
  per-box) if [ -n "${EF2INV_JIT_LOCAL_ROOT:-}" ]; then _EF2INV_JIT_ROOT="$EF2INV_JIT_LOCAL_ROOT"; mkdir -p "$_EF2INV_JIT_ROOT"; else _EF2INV_JIT_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/ef2inv-jitcache-XXXXXXXX") || { echo "configs/h100.env: EF2INV_JIT_CACHE=per-box — no private JIT-cache directory could be made under ${TMPDIR:-/tmp} (mktemp -d); name one with EF2INV_JIT_LOCAL_ROOT" >&2; return 2 2>/dev/null || exit 2; }; fi; unset TRITON_CACHE_DIR TORCHINDUCTOR_CACHE_DIR ;;   # forced: a pre-set shared dir is not inherited; without EF2INV_JIT_LOCAL_ROOT the root is a fresh directory made by mktemp -d (mode 0700, a name no other process predicts)
  *) echo "configs/h100.env: EF2INV_JIT_CACHE=${EF2INV_JIT_CACHE} — the shipped forms are shared | per-box (frozen:<sha256> is named, not shipped)" >&2; return 2 2>/dev/null || exit 2 ;;
esac
if [ -n "$_EF2INV_JIT_ROOT" ]; then
  TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$_EF2INV_JIT_ROOT/triton}"
  TORCHINDUCTOR_CACHE_DIR="${TORCHINDUCTOR_CACHE_DIR:-$_EF2INV_JIT_ROOT/inductor}"
fi
EF2INV_GPU="${EF2INV_GPU:-${MODEL_OPT_TARGET_GPU:-NVIDIA H100 80GB HBM3}}"                     # the pinned card (name + nvidia-smi MiB below): any other card is worded on one NOTE line before any work and runs (opt/ef2inv_opt/hardware.py)
EF2INV_GPU_MIB="${EF2INV_GPU_MIB:-81559}"
