# ef2inv — deployment parameters for one A100 machine, the 80 GB or the 40 GB part (compute capability 8.0), on the pinned stack's sm_80 variant (STOCK.md
# §Stack; stock/PINS.json pinned_stack.arch_variants.sm80). Sourced by run.sh --config a100 (set -a). The h100.env parameters
# unchanged — the same switches, the same fast-environment requirement, the same JIT-cache forms — with this card's two values set first:
# the card the NOTE compares (name + nvidia-smi MiB, either part's reading) and the shared JIT-cache key, which is
# DERIVED from the running stack (torch<v>-cu<NNN>-sm<cc> = torch2.11.0-cu128-sm80 on this card; opt_core.jit_cache) whenever the shared form
# names a root — a key that cannot be computed is refused by name, never defaulted. On this card `exact --det 1` equals `off --det 1` bit for
# bit (the A100's digits are its own: stock itself differs from its H100 digits); nothing here is compared across cards.
# PER-CARD DIFFERENCES (the complete list; anything not named here is identical to configs/h100.env): NONE in any mode's lever set, kernels,
# size floors or refusals — `exact` / `fast` / `big` engage the same levers and fail closed the same way (a lever that does not engage
# is exit 3 by name, `--allow-partial` the only opt-out); the two values below (expected card, JIT-cache key) are the whole difference.
# (Not a lever difference, named for completeness: `exact`'s cuEquivariance tile table carries one tile ENTRY per compute capability inside
# k/ef2_trimul.py — this card's sm_80 entry, the H100's sm_90 entry —, selected from the probed device, nothing set here.)
# THE ONE PER-CARD LEVER DIFFERENCE (until a row-invariant GEMM route is proven on sm_80): the ESM-C target-chain hoist k/ef2_esmc_hoist.py steps
# aside by name on this card in every kit mode — TransformerEngine's cuBLASLt GEMMs are not row-count invariant on sm_80, so its reduced feature
# pass cannot reproduce the full pass's bits; the arm prints `esmc hoist stepped_aside(cc_unproven:sm_80)` before the loop and `LEVER
# name=ef2_esmc_hoist state=stepped_aside served=0 … reason=cc_unproven:sm_80` after it, evidence applied, exit 0 (decided from the probed
# compute capability inside the lever, nothing set here; the H100 runs it).
EF2INV_GPU="${EF2INV_GPU:-${MODEL_OPT_TARGET_GPU:-A100}}"                  # names every A100 the clouds hand out (`NVIDIA A100-SXM4-80GB`, `NVIDIA A100 80GB PCIe`, `NVIDIA A100-SXM4-40GB`: containment, opt/ef2inv_opt/hardware.py)
EF2INV_GPU_MIB="${EF2INV_GPU_MIB:-81920|40960}"                                 # nvidia-smi memory.total of the 80 GB and the 40 GB part: both are this config's card; every memory-dependent choice (fast's checkpoint policy) reads the probed device, and a size that does not fit exits by name (exit 4) with the mode to rerun under
if [ -z "${EF2INV_JIT_KEY:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ] && [ "${EF2INV_JIT_CACHE:-shared}" = "shared" ]; then
  EF2INV_JIT_KEY="$(python -c 'from ef2inv_opt.modes import jit_cache_key; print(jit_cache_key())' 2>/dev/null)" || EF2INV_JIT_KEY=""
  if [ -z "$EF2INV_JIT_KEY" ]; then
    echo "configs/a100.env: the shared JIT-cache key of the running stack could not be computed (ef2inv_opt.modes.jit_cache_key: torch<v>-cu<NNN>-sm<cc> needs the card's compute capability and the installed core) — MODEL_OPT_JIT_ROOT names a shared root, so the key is required: set EF2INV_JIT_KEY=torch2.11.0-cu128-sm80 explicitly, or EF2INV_JIT_CACHE=per-box" >&2
    return 3 2>/dev/null || exit 3
  fi
fi
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"
