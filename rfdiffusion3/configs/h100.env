# H100 deployment parameters (configs/a100.env is the A100's: this file with its target-GPU word). The mode is NOT here: it comes from `--mode` or RFDIFFUSION3_OPT=exact|fast|off;
# no lever switch is set here (the mode table is opt/rfdiffusion3_opt/modes.py). usage: `run.sh design|check|warm --config h100 --mode <mode> ...`,
# or `source configs/h100.env` before `RFDIFFUSION3_OPT=exact rfd3 design ...` in the patched interpreter (the installed package activates at
# `import rfd3`). Every value can be pre-set in the environment; this file fills what is unset. It refuses (rc 3) when rfdiffusion3_opt is not importable on the
# `python` on PATH, and by name (the package's core pin gate: NOT ACTIVE, rc 3) when the core it stands on (opt_core) is absent or not the one opt/pyproject.toml
# [tool.opt_core] pins (every route, the stock route included, goes through the package). Two interpreters (both outside this
# tree): the `python` on PATH runs the kit modes (the kit's install.sh applied there once); RFDIFFUSION3_STOCK_PYTHON names the pristine one
# for `--mode off` — it is not defaulted here (a venv path is not a deployment parameter); unset, the stock arm runs in the `python` on PATH
# and proves it pristine or refuses. Two variables name box paths and have no default here (STOCK.md § Variables): RFD3_CKPT, the pinned checkpoint, and MODEL_OPT_JIT_ROOT, the optional root
# of persistent JIT caches (unset: each tool's own default location). Tested on the pinned stack (stock/PINS.json "pinned_stack": Python 3.12.1, torch 2.13.0+cu130, triton 3.7.1, NVIDIA apex 0.1).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this rfdiffusion3/ directory (the package locates the kit and the pins through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check reports what it sees
# RFD3_CKPT — the pinned checkpoint (rfd3_latest.ckpt, sha256 in stock/PINS.json "checkpoint"; where to get it: STOCK.md § Variables). A weights path is the box's, not the

# checkpoint. When it is set, upstream's own search path (checkpoint_registry.py:25-41) follows it unless pre-set, so that `ckpt_path=rfd3` resolves to the same file.
if [ -n "${RFD3_CKPT:-}" ]; then export RFD3_CKPT; export FOUNDRY_CHECKPOINT_DIRS=${FOUNDRY_CHECKPOINT_DIRS:-$(dirname "$RFD3_CKPT")}; fi
env -i PATH="$PATH" PYTHONPATH="${PYTHONPATH:-}" python -c "import rfdiffusion3_opt" 2>/dev/null || { echo "configs/h100.env: rfdiffusion3_opt is not importable on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3; }   # importability only, in a clean environment (the .pth-time refusal under RFDIFFUSION3_OPT[_*] is the next probe's line)
python -c "from rfdiffusion3_opt._autoload import core_gate; core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }   # the core pin gate: absent, or older than the pinned floor -> its NOT ACTIVE line, rc 3, before any other probe
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                           # torch<version sans local tag>-cu<CUDA sans dot>-sm<cc digits>, e.g. torch2.13.0-cu130-sm90
  _rfd3_jck_err=$(mktemp)
  if _rfd3_jck=$(python -c "from rfdiffusion3_opt.modes import jit_cache_key; print(jit_cache_key())" 2>"$_rfd3_jck_err"); then
    export MODEL_OPT_STACK_KEY="$_rfd3_jck"
    unset _rfd3_jck
  else
    echo "[rfdiffusion3-opt] configs/h100.env: jit_cache_key() failed — refusing rather than mis-keying the JIT/Triton cache with a silent placeholder. Cause:" >&2
    tail -n 3 "$_rfd3_jck_err" >&2
    rm -f "$_rfd3_jck_err"; unset _rfd3_jck _rfd3_jck_err
    return 2 2>/dev/null || exit 2
  fi
  rm -f "$_rfd3_jck_err"; unset _rfd3_jck_err
fi
for _v in TRITON_CACHE_DIR TORCH_EXTENSIONS_DIR TORCHINDUCTOR_CACHE_DIR; do eval "_d=\${$_v:-}"; if [ -n "$_d" ] && ! [ -d "$_d" ] && ! [ -d "$(dirname "$_d")" ]; then echo "[rfdiffusion3-opt] configs/h100.env: $_v=$_d dropped (neither it nor its parent directory exists)" >&2; unset "$_v"; fi; done; unset _v _d   # a pre-set cache directory is kept when it or its parent exists (a mounted cache); one inside an unmounted tree is dropped, by name on stderr (keyed under MODEL_OPT_JIT_ROOT below when that is set, else the tool's default)
# MODEL_OPT_JIT_ROOT — optional root of persistent JIT caches (STOCK.md § Variables): when set, the Triton, torch-extensions and inductor caches are keyed under it by the
# running stack, <root>/$MODEL_OPT_STACK_KEY/{triton,torch_extensions,inductor}, unless a cache directory is pre-set; when unset (or not writable) they are keyed the
# same way under a private per-user scratch root. The inductor cache: the stock route (upstream compile_model=true) warms from it; the KERNELS line's inductor_cache=cold|warm and compile_s name which cost a pass paid (rfd3/engine.py:231-232)
_jit_base=${MODEL_OPT_JIT_ROOT:-}
[ -z "$_jit_base" ] || export MODEL_OPT_JIT_ROOT
if [ -z "$_jit_base" ] || ! { mkdir -p "$_jit_base" && [ -w "$_jit_base" ]; } 2>/dev/null; then   # no root, or a root this process cannot write (read, never compiled into): the caches this file would key there go under a writable scratch root instead (MODEL_OPT_JIT_ROOT itself is left as set)
  _jit_base=${TMPDIR:-/tmp}/model_opt_jit-uid$(id -u)                    # per user (the uid ends its name), made with mode 0700; a path another user owns or can write, or a symbolic link, is not used: the three cache variables are then left as they are
  mkdir -p "${_jit_base%/*}" 2>/dev/null || :; mkdir -m 700 "$_jit_base" 2>/dev/null || :
  if [ -d "$_jit_base" ] && [ ! -L "$_jit_base" ] && [ -O "$_jit_base" ]; then case $(stat -c %a "$_jit_base" 2>/dev/null) in ''|*[2367]|*[2367]?) _jit_base="" ;; esac; else _jit_base=""; fi   # group / other write bits in the mode's last two digits refuse it too
  [ -n "$_jit_base" ] || echo "[rfdiffusion3-opt] configs/h100.env: ${TMPDIR:-/tmp}/model_opt_jit-uid$(id -u) refused (another owner, open to group or others, a symbolic link, or not creatable): TRITON_CACHE_DIR, TORCH_EXTENSIONS_DIR, TORCHINDUCTOR_CACHE_DIR left as set" >&2
fi
if [ -n "$_jit_base" ]; then
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$_jit_base/$MODEL_OPT_STACK_KEY/triton}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$_jit_base/$MODEL_OPT_STACK_KEY/torch_extensions}
  export TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$_jit_base/$MODEL_OPT_STACK_KEY/inductor}
fi
unset _jit_base
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}                                  # torch's allocator in expandable-segments mode: under the kit modes the captured step's private pool persists across the designs of a pass and the next design's initializer runs beside it — the default allocator fragments there at long lengths (500 residues, B=16: out of memory at the second design with 6.8 GiB reserved-unallocated; completes with this setting); placement only, no effect on numerics; the KERNELS line's alloc_conf= reads it back
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
