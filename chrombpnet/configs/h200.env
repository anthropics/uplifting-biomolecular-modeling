# H200 deployment parameters. No mode is set here: the mode comes from `--mode`, from CHROMBPNET_OPT in the caller's environment, or from the
# package default (opt/chrombpnet_opt/modes.py DEFAULT_MODE = fast); a config never chooses it. usage: `run.sh pred_bw|check|warm --config h200 [--mode off|exact|fast] [--det 0|1 (off only)] ...`, or `source configs/h200.env` before calling
# the package directly. Every value can be pre-set in the environment; this file fills what is unset from the two roots it requires,
# CHROMBPNET_OPT_WEIGHTS and CHROMBPNET_OPT_DATA (README.md, Variables; not set -> rc 2, the variable named). It refuses (rc 2) when
# chrombpnet_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package). No kit lever
# switch lives here (the kit decides its route from its own tables; its switch names are listed in opt/chrombpnet_opt/registry.py); the
# stock's own environment block is the caller's, not this file's.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this chrombpnet/ directory (the package locates the kit through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (the nvidia-smi name substring); run.sh notes another card
[ -n "${CHROMBPNET_OPT_WEIGHTS:-}" ] || { echo "[chrombpnet-opt] NOT ACTIVE mode=${CHROMBPNET_OPT:-fast} reason=CHROMBPNET_OPT_WEIGHTS is not set — see README Variables (the weights root)" >&2; return 2 2>/dev/null || exit 2; }
[ -n "${CHROMBPNET_OPT_DATA:-}" ] || { echo "[chrombpnet-opt] NOT ACTIVE mode=${CHROMBPNET_OPT:-fast} reason=CHROMBPNET_OPT_DATA is not set — see README Variables (the data root)" >&2; return 2 2>/dev/null || exit 2; }
export CHROMBPNET_OPT_WEIGHTS CHROMBPNET_OPT_DATA                                                                    # the weights root and the data root: required, no default (README.md, Variables)
export CHROMBPNET_OPT_CACHE_TAR=${CHROMBPNET_OPT_CACHE_TAR:-$CHROMBPNET_OPT_WEIGHTS/cache/nv_compute_cache_H200.tar}   # the kit's own per-class name (opt/kit_ho/tf/pred_bw_fast.py _JIT_TAR); the file is staged only where a capture exists for this class
export CHROMBPNET_OPT_MODEL=${CHROMBPNET_OPT_MODEL:-$CHROMBPNET_OPT_WEIGHTS/GM12878_ATAC/fold_0/chrombpnet_recompiled.h5}   # the -cm model; bias_scaled.h5 / nobias.h5 beside it (the K1 route's component models, opt/kit_ho/tf/pred_bw_fast.py)
export CHROMBPNET_OPT_GENOME=${CHROMBPNET_OPT_GENOME:-$CHROMBPNET_OPT_DATA/hg38.genome.fa}                           # the reference genome fasta (-g), indexed (.fai beside it)
export CHROMBPNET_OPT_CHROM_SIZES=${CHROMBPNET_OPT_CHROM_SIZES:-$CHROMBPNET_OPT_DATA/hg38.chrom.sizes}                # the chromosome sizes (-c)
export CHROMBPNET_OPT_REGIONS=${CHROMBPNET_OPT_REGIONS:-$CHROMBPNET_OPT_DATA/regions.bed}                             # the regions file (-r; warm's default input): the stock's narrowPeak schema (10 columns, summit in column 10)
export CHROMBPNET_OPT_BIGWIG=${CHROMBPNET_OPT_BIGWIG:-$CHROMBPNET_OPT_DATA/ENCFF180XQC.bigWig}                        # the observed bigWig (-bw; the metrics stage): ENCODE ENCFF180XQC (GM12878 ATAC-seq signal)
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the tree
[ -z "${MODEL_OPT_JIT_ROOT:-}" ] || export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/torch2.4.1-cu124-sm90/triton}"   # a compile-cache root, when the caller sets one, holds the Triton forward's cache; unset: Triton's own default
python -c "import chrombpnet_opt" 2>/dev/null || { echo "[chrombpnet-opt] NOT ACTIVE mode=${CHROMBPNET_OPT:-fast} reason=chrombpnet_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2; }
