# A100 deployment parameters. No mode is set here: the mode comes from `--mode`, from CHROMBPNET_OPT in the caller's environment, or from the
# package default (opt/chrombpnet_opt/modes.py DEFAULT_MODE = fast); a config never chooses it. usage: `run.sh <command> --config a100 [--mode off|exact|fast] [--det 0|1 (off only)] ...`, or `source configs/a100.env` before calling
# the package directly. Every value can be pre-set in the environment; this file fills what is unset from the two roots it requires,
# CHROMBPNET_OPT_WEIGHTS and CHROMBPNET_OPT_DATA (README.md, Variables; not set -> rc 2, the variable named). It refuses (rc 2) when
# chrombpnet_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package). No kit lever
# switch lives here (the kit decides its route from its own tables; its switch names are listed in opt/chrombpnet_opt/registry.py); the
# stock's own environment block is the caller's, not this file's.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this chrombpnet/ directory (the package locates the kit through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (the nvidia-smi name substring); run.sh notes another card
[ -n "${CHROMBPNET_OPT_WEIGHTS:-}" ] || { echo "[chrombpnet-opt] NOT ACTIVE mode=${CHROMBPNET_OPT:-fast} reason=CHROMBPNET_OPT_WEIGHTS is not set — see README Variables (the weights root)" >&2; return 2 2>/dev/null || exit 2; }
[ -n "${CHROMBPNET_OPT_DATA:-}" ] || { echo "[chrombpnet-opt] NOT ACTIVE mode=${CHROMBPNET_OPT:-fast} reason=CHROMBPNET_OPT_DATA is not set — see README Variables (the data root)" >&2; return 2 2>/dev/null || exit 2; }
export CHROMBPNET_OPT_WEIGHTS CHROMBPNET_OPT_DATA                                                                    # the weights root and the data root: required, no default (README.md, Variables)
export CHROMBPNET_OPT_CACHE_TAR=${CHROMBPNET_OPT_CACHE_TAR:-$CHROMBPNET_OPT_WEIGHTS/cache/nv_compute_cache_A100.tar}   # the kit's own per-class name (opt/kit_ho/tf/pred_bw_fast.py _JIT_TAR); the file is staged only where a capture exists for this class
export CHROMBPNET_OPT_MODEL=${CHROMBPNET_OPT_MODEL:-$CHROMBPNET_OPT_WEIGHTS/GM12878_ATAC/fold_0/chrombpnet_recompiled.h5}   # the -cm model file; bias_scaled.h5 / nobias.h5 beside it (the K1 route's component models: fast on this card, both kit modes on H100 / H200; opt/kit_ho/tf/pred_bw_fast.py)
export CHROMBPNET_OPT_GENOME=${CHROMBPNET_OPT_GENOME:-$CHROMBPNET_OPT_DATA/hg38.genome.fa}                           # the reference genome fasta (-g), indexed (.fai beside it)
export CHROMBPNET_OPT_CHROM_SIZES=${CHROMBPNET_OPT_CHROM_SIZES:-$CHROMBPNET_OPT_DATA/hg38.chrom.sizes}                # the chromosome sizes (-c)
export CHROMBPNET_OPT_REGIONS=${CHROMBPNET_OPT_REGIONS:-$CHROMBPNET_OPT_DATA/regions.bed}                             # the regions file (-r): the stock's narrowPeak schema (10 columns, summit in column 10)
export CHROMBPNET_OPT_BIGWIG=${CHROMBPNET_OPT_BIGWIG:-$CHROMBPNET_OPT_DATA/ENCFF180XQC.bigWig}                        # the observed bigWig (-bw; the metrics stage): ENCODE ENCFF180XQC (GM12878 ATAC-seq signal)
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the tree
[ -z "${MODEL_OPT_JIT_ROOT:-}" ] || export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/torch2.4.1-cu124-sm80/triton}"   # a compile-cache root, when the caller sets one, holds the Triton forward's cache; unset: Triton's own default
python -c "import chrombpnet_opt" 2>/dev/null || { echo "[chrombpnet-opt] NOT ACTIVE mode=${CHROMBPNET_OPT:-fast} reason=chrombpnet_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2; }
# Per-card differences from configs/h100.env (anything not listed here is identical to H100):
#  - forward route: `--mode fast` (the shipped numerics) runs the K1 Triton forward with its convolutions on the tensor cores (TF32 — the
#    stock's own precision class on this card; opt/kit/torch/chrombpnet_k1/arch_tiles.json entries[cuda-80]: prod route k1, the sm_80 tc_tile).
#    No sm_80 Triton kernel cache ships: the kernels compile on first use into the Triton cache dir, said on the kit's line.
#  - no `exact` on this card: `--mode exact` is refused by name, exit 3, nothing runs (`[chrombpnet-opt] NOT ACTIVE mode=exact reason=the kit
#    refused by name: no bitwise Triton route on cuda-80 (gpu=A100) …` — the fp32 kernels match the A100 stock's profile logits bit for bit but
#    its log-counts only at some batch shapes: the sm_80 counts-head summation order varies with the regions per call); `--mode off --det 1` is
#    the deterministic run on this card.
#  - native dilation: off (not bit-identical to the stock's default draw on sm_80).
#  - tail: the stock's own tail shape (the padded tail is an H100 / H200 lever).
#  - compute cache: no nv_compute_cache tarball ships for this card — the driver JIT-compiles kernels at first use (CHROMBPNET_OPT_CACHE_TAR
#    above names where one would go).
#  - host-side levers (featurisation, HDF5 / bigWig writers, metrics overlap, CPU sizing, host allocator): identical to H100.
