# B200 (180 GB, compute capability 10.0) deployment parameters (one GPU; `--n_gpu 2|4|8` row-shards `big` over P cards). The mode is NOT here: it comes from `--mode` or OPENFOLD3_OB0_OPT
# (the GPU count from `--n_gpu` or OPENFOLD3_OB0_OPT_N_GPU); no lever switch is written in this file — the mode table is opt/openfold3_ob0_opt/modes.py. usage:
# `run.sh pred|check|warm --config b200 --mode <mode> ...`, or `source configs/b200.env` before calling the package directly. Every value can be pre-set in the environment; this file fills
# what is unset. It refuses (rc 3, NOT ACTIVE) when openfold3_ob0_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the
# package). Pinned stack: python 3.11.5, torch 2.10.0+cu128, triton 3.6.0 (stock/PINS.json "pinned_stack").
# Per-card differences from configs/h100.env — the complete list; anything not named here is the identical code path and lever set on both cards:
#   1. image: the sm_80/sm_100-inclusive image variant (where the image carries deepspeed's DS4Sci evoformer_attn op (off in this kit's stock configuration and in every mode's runner yaml, so no route of this kit loads it) a caller's DS4Sci runner yaml needs the op compiled with sm_100 in its TORCH_CUDA_ARCH_LIST); an sm_90-only op fails a DS4Sci route on this card by name (CUDA: no kernel image is available for execution on the device), never degraded.
#   2. fast line, pair cells (levers triatt_block, pair_transition, trimul_v4): the same kernels with this card's launch tiles — the cc 10.0 rows of opt_core
#      attn/pair_fused_cells.json and the `10.0|*` cells of the core's fpf_trimul_v4 table (opt_core/kernels/fpf_trimul_v4/table.json); shapes a table does not list keep their per-call routes and
#      census words (`fallback:<reason>=<n>`, exit 0) as on H100.
#   3. fast line flash triangle attention and the tp line's row-block kernels (tp_triatt = opt_core kernels/flash_triattn.py, tp_trimul = the fpf_trimul_v4 cells above):
#      the same kernels; launch tiles from the tables' `10.0|*` rows; a Triton build failure of a tuned cell nets to the core's safe settings for cc 10.0
#      (opt_core kernels/safe_settings.py SAFE_ROWS, one stderr line, census `settings=safe:…`), never a silent downgrade.
#   4. big --n_gpu P: the same chunk plan (the 80 GB-card table, tp.CHUNK_PLAN); the card's larger memory is headroom, not a different plan.
# Every lever runs the identical code path as on H100; the card is outside the kit's tested set (registry TESTED_SM) and the ACTIVE line's card_support=
# word says so. A lever of a mode that cannot run on a card is a named refusal of the mode (exit 3), never a silent downgrade; an untested
# card or library version engages the lever with its default settings, named; documented size/shape gates keep their census words and exit 0.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this openfold3_ob0/ directory (the package locates the add-ons through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-B200}                                                            # the GPU this configuration targets (compute capability 10.0); check/pred report a mismatch
# OPENFOLD3_OB0_CKPT is not filled here: the pinned weights are of3-ob-2025-06-30-174k.pt (OpenBind-0), sha256 bd43301c… (stock/PINS.json "weights"),
# and every route hashes the file it is given against that digest (one WEIGHTS line: pinned, or an unknown-checkpoint WARNING — every mode proceeds, labelled weights_pinned=false).
# Set OPENFOLD3_OB0_CKPT (or pass --ckpt) to the pinned bytes (`run.sh install --weights DIR` fetches them); pred / warm refuse by name without one.
[ -n "${OPENFOLD3_OB0_CKPT:-}" ] && export OPENFOLD_CACHE=${OPENFOLD_CACHE:-$(dirname "$OPENFOLD3_OB0_CKPT")}             # upstream's cache directory (entry_points/parameters.py). Upstream reads two things there: a user runner.yml (deep-merged UNDER any --runner-yaml when present —
# the kit names such a merge on stderr when that file exists) and the ckpt_root pointer (unused here: every route passes --inference-ckpt-path). Default: the checkpoint's own
# directory unless the caller sets one; the routes apply the same default without this file (cli.openfold_cache_default). With --inference-ckpt-name (upstream's registry NAME instead of a
# path) upstream resolves the file in its parameter directory under $OPENFOLD_CACHE and refuses by name when it is absent (entry_points/validator.py) — no download at predict time
_of3_err=$(python -c "import openfold3_ob0_opt" 2>&1 >/dev/null) || { _of3_rc=$?; case "$_of3_err" in *"ModuleNotFoundError: No module named 'openfold3_ob0_opt'"*) echo "[openfold3_ob0-opt] NOT ACTIVE: reason=package_missing: openfold3_ob0_opt is not importable on $(command -v python || echo 'python (not on PATH)') (${_of3_err##*$'\n'}): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3 ;; esac; printf '%s\n' "$_of3_err" >&2; return "$_of3_rc" 2>/dev/null || exit "$_of3_rc"; }   # the package itself (imports nothing of the core). `package_missing` names ONLY a ModuleNotFoundError of openfold3_ob0_opt; every other failure — the installed .pth hook's by-name refusal at interpreter start under an exported OPENFOLD3_OB0_OPT* (undeclared variable / the core pin gate / producer probe: rc 3) or any import error — is forwarded verbatim with the interpreter's own exit code, never re-diagnosed
python -c "import openfold3_ob0_opt._core_gate as g, os; g.gate(os.path.dirname(os.path.abspath(g.__file__)), tag='openfold3_ob0-opt')" || { return 3 2>/dev/null || exit 3; }   # the core pin gate (openfold3_ob0_opt/_core_gate.py = the house template): an absent or mismatched opt_core is its NOT ACTIVE line, rc 3, before anything else runs
unset _of3_err _of3_rc
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -c "from openfold3_ob0_opt.modes import jit_cache_key; print(jit_cache_key())") || { echo "[openfold3_ob0-opt] NOT ACTIVE: reason=core_missing: the JIT cache key probe (openfold3_ob0_opt.modes.jit_cache_key) failed on $(command -v python || echo 'python (not on PATH)')" >&2; return 3 2>/dev/null || exit 3; }; fi; export MODEL_OPT_STACK_KEY   # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.10.0-cu128-sm90
# MODEL_OPT_JIT_ROOT (optional): a persistent root for the compiled-kernel caches. When set, the Triton cache is keyed by the running stack under it —
# TRITON_CACHE_DIR=<root>/<MODEL_OPT_STACK_KEY>/triton: upstream's own Triton triangle kernels (stock, when its configuration runs them) and the trunk-kernels
# flash triangle attention of `fast` both compile into it — unless pre-set; when unset nothing is exported and Triton uses its default (~/.triton/cache).
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}   # torch C++/CUDA extensions built at first use (the sm80 triangle-attention arm on compute capability 8.0) keyed the same way
fi
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
