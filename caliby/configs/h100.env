# H100 deployment parameters (configs/a100.env is the A100's: this file with its target-GPU word). The mode and the variant are NOT here: they come from `--mode` /
# `--variant` or CALIBY_OPT / CALIBY_VARIANT, and no lever switch is ever set here (the mode table is opt/caliby_opt/modes.py).
# usage: `run.sh design|check|warm --config h100 --mode <mode> [--variant single|ensemble32] ...`, or `source configs/h100.env`
# before calling the package directly. Every value can be pre-set in the environment; this file fills what is unset and bakes in no machine's paths (README.md "Variables"):
# MODEL_PARAMS_DIR has no default (unset: every verb refuses by name); MODEL_OPT_JIT_ROOT is the optional shared JIT-cache root. It refuses (rc 3, NOT ACTIVE) when caliby_opt is not importable on the `python` on PATH or the core pin gate refuses the shared core opt_core (absent, older/newer or edited:
# opt/caliby_opt/_core_gate.py, before anything of the core is imported; every route, the stock route included, goes through the package), and (rc 3) when the JIT-cache key is not
# resolvable. Pinned stack: python 3.12.10, torch 2.6.0+cu124, triton 3.2.0 (stock/PINS.json "pinned_stack").
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this caliby/ directory (the package locates the kits through it)
python -c "import caliby_opt" 2>/dev/null || { echo "[caliby-opt] NOT ACTIVE: caliby_opt is not importable on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3; }
python -c "from caliby_opt.stack import core_gate; core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                    # the core pin gate before any other probe: an absent / older / newer / edited shared core is its one NOT ACTIVE line, rc 3
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); the activation and check lines report a mismatch with the box's GPU (never a refusal)
export MODEL_OPT_STATE=${MODEL_OPT_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/caliby_opt}                                # out-of-tree state: warm's scratch outputs
if [ -n "${MODEL_PARAMS_DIR:-}" ]; then export MODEL_PARAMS_DIR; fi                                                  # REQUIRED, no default: the weights root holding caliby/<model_name>.ckpt and protpardelle-1c/{weights,configs}/ (sha256 in stock/PINS.json "weights"; STOCK.md "Weights" fetches them); unset -> the package refuses by name
export HF_HUB_OFFLINE=1                                                                                              # nothing is fetched at run time (upstream downloads weights on first use otherwise)
export PDB_MIRROR_PATH=${PDB_MIRROR_PATH:-} CCD_MIRROR_PATH=${CCD_MIRROR_PATH:-}                                     # required by atomworks, empty for this use (upstream env_setup.sh:9-10)
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                       # torch<version>-cu<CUDA>-sm<cc>, e.g. torch2.6.0-cu124-sm90
  if ! MODEL_OPT_STACK_KEY=$(python -c "from caliby_opt.modes import jit_cache_key; print(jit_cache_key())" 2>&1) || [ "${MODEL_OPT_STACK_KEY#unknown:}" != "$MODEL_OPT_STACK_KEY" ]; then
    echo "configs/h100.env: MODEL_OPT_STACK_KEY not resolvable ($MODEL_OPT_STACK_KEY): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt, or set MODEL_OPT_STACK_KEY yourself" >&2
    unset MODEL_OPT_STACK_KEY; return 3 2>/dev/null || exit 3
  fi
fi
export MODEL_OPT_STACK_KEY
for _v in TRITON_CACHE_DIR; do eval "_d=\${$_v:-}"; if [ -n "$_d" ] && ! [ -d "$_d" ] && ! [ -d "$(dirname "$_d")" ]; then unset "$_v"; fi; done; unset _v _d   # a pre-set cache directory is kept when it or its parent exists (a mounted or shared cache); one under a tree that does not exist is dropped (the line below or Triton's own default applies)
if [ -z "${TRITON_CACHE_DIR:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then export TRITON_CACHE_DIR="$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton"; fi   # the optional shared JIT-cache root (README.md "Variables"): the Triton cache of the fused LCP kernel at <root>/<stack key>/triton; both unset -> Triton's own default (~/.triton/cache)
if [ -z "${TORCHINDUCTOR_CACHE_DIR:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then export TORCHINDUCTOR_CACHE_DIR="$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/inductor"; fi   # likewise the TorchInductor cache of upstream's torch.compile'd denoiser (else torch's /tmp/torchinductor_<user>)
export TQDM_DISABLE=${TQDM_DISABLE:-1}                                                                               # keeps logs line-oriented (no progress bars)
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc written into the tree
