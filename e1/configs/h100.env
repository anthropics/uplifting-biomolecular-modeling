# H100 deployment parameters (the only configuration in this tree). The mode and the variant are NOT here: they come from `--mode` / `--variant`
# or E1_OPT / E1_VARIANT. usage: `run.sh score|check|warm --config h100 --variant 300m --mode <mode> ...`, or `source configs/h100.env`
# before calling the package directly. Every value can be pre-set in the environment; this file fills what is unset.
# Where the weights and the JIT caches live is NOT set here: HF_HOME / KERNELS_CACHE / TRITON_CACHE_DIR / TORCHINDUCTOR_CACHE_DIR keep the
# libraries' own defaults unless the environment sets them; the optional MODEL_OPT_JIT_ROOT keys the two JIT caches by stack (STOCK.md "Variables").
# It refuses (rc 2) when e1_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package).
# Pinned stack: python 3.12, torch 2.8.0+cu128, triton 3.4.0 (the kit's pins module, opt/forward/engines/e1/kits/pins.py STACK).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this e1/ directory (the package locates the kit tree through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU class this configuration targets; a card of another class is named on the ACTIVE line, not refused
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1                                                                       # nothing is fetched at run time: the weights and the hub RMSNorm kernel are read from the Hugging Face cache (HF_HOME, else ~/.cache/huggingface; KERNELS_CACHE when set) — STOCK.md "Variables"
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc written into the kit tree
python -c "import e1_opt" 2>/dev/null || { echo "[e1-opt] NOT ACTIVE: e1_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2; }
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                             # optional shared JIT-cache root: <root>/<stack key>/{triton,inductor}, each unless already set; unset -> nothing exported (the libraries' defaults)
  MODEL_OPT_STACK_KEY=${MODEL_OPT_STACK_KEY:-$(python -c "from e1_opt.stack import jit_cache_key; print(jit_cache_key())")} || { echo "[e1-opt] NOT ACTIVE: MODEL_OPT_JIT_ROOT=$MODEL_OPT_JIT_ROOT is set and the stack key could not be computed (python -c 'from e1_opt.stack import jit_cache_key; print(jit_cache_key())' on $(command -v python))" >&2; return 2 2>/dev/null || exit 2; }
  export MODEL_OPT_STACK_KEY                                                                                         # torch<version>-cu<CUDA>-sm<arch>, e.g. torch2.8.0-cu128-sm90
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}                          # the Triton JIT cache (the kit's kernels, the hub RMSNorm kernel)
  export TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/inductor}          # the Inductor cache (the compiled forward)
fi
