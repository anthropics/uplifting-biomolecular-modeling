   "monomer": {
    "num_recycles": 4,
    "mlm_prob": 0.15,
    "num_samples": 5,
    "num_steps": "20 (<=512) / 30 (<=1024) / 100 (>1024)"
   },
   "multimer": {
    "num_recycles": 10,
    "mlm_prob": 0.2,
    "num_samples": 5,
    "num_steps": 200
   }
  }
 }
