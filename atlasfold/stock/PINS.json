 "weights_bundle": {
  "filename": "atlasfold_weights_v1.0.0.tar",
  "layout": "a weights root holds the three Hugging Face repositories side by side, <root>/<hf-repo>/{config.json,README.md,weights/*.pth}, as `hf download SeonghwanSeo/<repo> --local-dir <root>/<repo>` writes them (README 'Setup'); `run.sh install --weights <root>` downloads nothing and compares each weights/*.pth with the 'weights' entries above (bytes and sha256); a root holding this archive extracted, <root>/atlasfold_weights_v1.0.0/<hf-repo>/..., is accepted as well",
  "sha256": "240fb90409952a971e07dfba33a0a7f6f1f5d9409271995bcb2fab0c4cc21667",
  "not_included": "SeonghwanSeo/atlaslm-600m-base (deprecated, gated) \u2014 not part of the layout; no mode reads it"
 },
 "stack": {
  "opt_core": {
   "path": "../../common/opt_core",
   "min_version": "0.5.18.8"
  },
  "lock_A_h100_cu128_torch271": {
   "python": "3.11",
   "torch": "2.7.1+cu128",
   "cuequivariance_torch": "0.10.0",
   "cuequivariance_ops_torch_cu12": "0.10.0",
   "triton": "present (image)",
   "note": "authors profiled torch 2.10.0 / CUDA 12.8 / cuEquivariance 0.10.0 on B200; lock B (authors' stack) and lock C (cu130/torch 2.13, B300) are planned"
  }
 },
 "stock_environment": {
  "must_be_absent_prefixes": [
   "ATLASFOLD_OPT",
   "AFO_",
   "FPF_",
   "OPT_CORE_"
  ],
