# Deployment parameters for H100 (sm90) on the pinned stack (CUDA 12.8 user space, Python 3.11, torch 2.7.1+cu128, cuequivariance-torch 0.10.0). Never the mode.
export ATLASFOLD_WEIGHTS_DIR="${ATLASFOLD_WEIGHTS_DIR:-/weights/atlasfold}"   # weights root: <root>/<repo>/weights/<file>.pth for the three upstream Hugging Face repos (STOCK.md)
export MODEL_OPT_JIT_ROOT="${MODEL_OPT_JIT_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/atlasfold_opt/jit}"    # first-use compile caches (Triton / Inductor / torch extensions / opt_core NVRTC cubins), keyed by the running stack under it (cli.jit_env; `run.sh warm` fills it once per stack)
export AFO_TARGET_GPU="H100(sm90)"
export KMP_AFFINITY=disabled
