# A100 (compute capability 8.0; the 80 GB and the 40 GB card) deployment parameters; configs/h100.env is the H100 file of the same shape. The mode and the variant are NOT here: they come from `--mode` / `--variant`
# or AF3_JAX_OPT / AF3_JAX_VARIANT. usage: `run.sh pred|check|warm|install --config a100 --variant p2 --mode <mode> ...`, or
# `source configs/a100.env` before calling the package directly. Every value can be pre-set in the environment; this file
# fills what is unset and carries no box path: the two directories of a deployment are the caller's (STOCK.md "Variables") —
# AF3_JAX_PARAMS_ROOT (the converted parameters, <root>/<variant>/of3_ported_weights.bin.zst; unset, every verb refuses by name unless the caller
# passes --model_dir) and AF3_JAX_CACHE_ROOT (a persistent, writable cache root; unset, the package default af3_jax_opt/stack.py DEFAULT_CACHE_ROOT).
# It refuses (rc 2) when af3_jax_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package;
# the pinned stack's values below are read from stock/PINS.json through it). Pinned stack: stock/PINS.json "image" = upstream's
# environment/Dockerfile (python 3.12.1, jax 0.10.2 + jax-cuda12-plugin 0.10.2; the package list environment/requirements.lock).
# Per-card differences from configs/h100.env: none but MODEL_OPT_TARGET_GPU — every mode's lever set and code path are the H100 ones (a lever that cannot engage
# is the same NOT ACTIVE refusal as on H100); the FlashPairformer Pallas kernels of fast/big take the shared core's compute-capability-8.0 tile table (SERVED tiles=own:8.0).
# The 80 GB and the 40 GB card source this same file: nothing here or in the package keys on a card's memory size (the package's gate reads the device itself:
# memory >= 24 GB, compute capability >= 8.0). An input one card's memory does not hold ends by name — XLA's RESOURCE_EXHAUSTED in the transcript, DONE
# status=FAILED — never in a fallback; `--mode big --n_gpu P` is the route past one card's memory.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this af3_jax/ directory (the package locates the kit through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0); check reports the box's own key
_AF3_JAX_PROBE=$(python -c "import af3_jax_opt" 2>&1) || { _rc=$?     # the import probe: the package ABSENT is named here (rc 2); any other failure of the import keeps the interpreter's own words and exit code
  case "$_AF3_JAX_PROBE" in *"No module named 'af3_jax_opt'"*) echo "[af3-jax-opt] NOT ACTIVE: af3_jax_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2 ;; esac
  printf '%s\n' "$_AF3_JAX_PROBE" >&2; echo "[af3-jax-opt] NOT ACTIVE: importing af3_jax_opt failed on $(command -v python || echo 'python (not on PATH)') (rc $_rc; the interpreter's words above)" >&2; return $_rc 2>/dev/null || exit $_rc; }
unset _AF3_JAX_PROBE
EXPORTS=$(python -c 'import os, af3_jax_opt as p
from af3_jax_opt._autoload import TAG
from af3_jax_opt._core_gate import gate
gate(os.path.dirname(os.path.abspath(p.__file__)), tag=TAG)       # THE pin gate (kit_template/_core_gate.py copy): the shared core absent or not the pinned one → its NOT ACTIVE line, exit 3 — nothing filled, nothing silently unset
import af3_jax_opt.stack as s; print(s.config_exports())') || { _rc=$?; return $_rc 2>/dev/null || exit $_rc; }
eval "$EXPORTS"   # from stock/PINS.json "image", each only where unset: AF3_JAX_REPO (the fork checkout: run_alphafold.py, convert_of3_weights.py; the kit's run_alphafold_fast.py is copied beside it), AF3_JAX_PY (the fork's interpreter), the XLA trio of the pinned stack — upstream's docker/Dockerfile layout; set both for a checkout / environment elsewhere
# AF3_JAX_PARAMS_ROOT — the caller's, never filled here: converted parameters at <root>/<variant>/ (of3_ported_weights.bin.zst; sha256 in stock/PINS.json "variants"; `run.sh install` writes them there)
# AF3_JAX_CACHE_ROOT  — the caller's, never filled here: $CACHE per key = <root>/<GPU model>__jax<ver>_jaxlib<ver>/ for exact (off shares it when the caller passes that --cache_dir; unstated, off keeps a fresh
#                       JAX cache per pass), <...>__fast/ for fast, <...>__big-…/ for the memory mode's own program (JAX compilation cache + the tokamax autotuning table); built by `warm`, persistent; unset = the package default (af3_jax_opt/stack.py DEFAULT_CACHE_ROOT)
# Per-lever card notes. TRIATT_XLA and TRIMUL_CD (fast / big) name the shared core's provider (opt_core.kernels.pallas) by the mode's tier word on this card as on
# an H100 — its compute-capability-8.0 cells decide the implementation per size (the pre-compiled sm_90a CUDA kernels are compute capability 9.0 only; a cell the
# provider has not measured is printed as UNCOVERED_CELL, served by its declared fallback and counted as tcd_uncovered= on the SERVED line). ATOM_ATTN: Pallas
# programs of 32 x 128 x 32 per (query subset, head), <= 30 KB shared memory — nothing to retune on this card. HOIST_LOGITS, COND_SHARE, ATOM_COND_HOIST,
# SAMPLER_BF16, DATTN, TTR, LNP: nothing card-specific. --mode big's memory line (above its size boundary) leaves the fused pair kernels FPF_TRIATT + TTR off
# by name on this card class, where they hold memory (the BIG NOTE line says so); fast keeps them.
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the kit tree
