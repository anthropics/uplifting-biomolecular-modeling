+class FeaturisationPrefetcher:
+  """Featurises (fold input, seed) items in worker processes ahead of the GPU.
+
+  Items are submitted in the exact order the main loop will consume them; each
+  item is computed by `_featurise_one_seed`, i.e. by the same code with the same
+  per-seed RandomState as the sequential path, so features are identical.
+  """
+
+  def __init__(self, num_workers: int, prefetch: int):
+    import concurrent.futures
+    import multiprocessing
+
+    self._pool = concurrent.futures.ProcessPoolExecutor(
+        max_workers=num_workers, mp_context=multiprocessing.get_context('fork')
+    )
+    self._prefetch = max(1, prefetch)
+    self._pending = collections.OrderedDict()
+    self._queue = collections.deque()
+
+  def enqueue(self, key, fold_input, seed, **featurise_kwargs):
+    self._queue.append((key, fold_input, seed, featurise_kwargs))
+    self._top_up()
+
+  def _top_up(self):
+    while self._queue and len(self._pending) < self._prefetch:
+      key, fold_input, seed, kw = self._queue.popleft()
+      self._pending[key] = self._pool.submit(_featurise_one_seed, fold_input, seed, **kw)
+
+  def get(self, key) -> features.BatchDict:
+    self._top_up()
+    if key not in self._pending:
+      raise KeyError(f'Featurisation item {key} was never enqueued.')
+    example = self._pending.pop(key).result()
+    self._top_up()
+    return example
+
+  def shutdown(self):
+    self._pool.shutdown(wait=False, cancel_futures=True)
+
+
+class OutputWriter:
+  """One writer thread behind the GPU (--output_writer): fold job i's result
+  extraction and output writing run on it while fold job i+1's inference runs.
+
+  Tasks run strictly in submission order on the one thread (per-seed
+  extraction, then the job's write), so a job's write sees its extractions
+  finished; a failure on the thread is re-raised in the main thread at the
+  next submission or at drain().
+  """
+
+  def __init__(self):
+    self._pool = concurrent.futures.ThreadPoolExecutor(
+        max_workers=1, thread_name_prefix='output_writer'
+    )
+    self._pending: list[concurrent.futures.Future] = []
+
+  def submit(self, fn, *args, **kwargs) -> concurrent.futures.Future:
+    for done in [f for f in self._pending if f.done()]:
+      self._pending.remove(done)
+      done.result()  # re-raise an earlier extraction / write failure here
+    future = self._pool.submit(fn, *args, **kwargs)
+    self._pending.append(future)
+    return future
+
+  def drain(self) -> None:
+    """Blocks until every submitted extraction and write has finished."""
+    pending, self._pending = self._pending, []
+    for future in pending:
+      future.result()
+
+  def shutdown(self) -> None:
+    self.drain()
+    self._pool.shutdown(wait=True)
+
