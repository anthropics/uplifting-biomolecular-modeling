# opt_core autoload guard: package=esmc_opt env=ESMC_OPT tag=esmc-opt exit=3
import os as _o, sys as _s; exec("try:\n import esmc_opt._autoload\nexcept SystemExit as _x:\n _s.stderr.flush(); _o._exit(_x.code if isinstance(_x.code, int) else 3)\nexcept BaseException as _e:\n if (_o.environ.get('ESMC_OPT') or '').strip().lower() not in ('', 'off'):\n  _s.stderr.write('[esmc-opt] NOT ACTIVE: esmc_opt._autoload is not importable (%s: %s) under ESMC_OPT=%s (exit 3)\\n' % (type(_e).__name__, _e, _o.environ.get('ESMC_OPT'))); _s.stderr.flush(); _o._exit(3)\n")
