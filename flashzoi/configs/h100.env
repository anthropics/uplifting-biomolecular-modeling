# H100 deployment parameters (the only configuration in this tree). The mode is NOT here: it comes from `--mode` or FLASHZOI_OPT. usage:
# `run.sh pred|check|warm --config h100 --mode <mode> ...`, or `source configs/h100.env` before calling the package or the kit's own
# programs directly. Paths come from the caller's environment (STOCK.md "Variables"): FLASHZOI_WEIGHTS names the weights' hub cache (or
# HF_HUB_CACHE / HF_HOME directly), MODEL_OPT_JIT_ROOT optionally names a shared JIT-cache root (TRITON_CACHE_DIR = <root>/<stack key>/triton
# unless TRITON_CACHE_DIR itself is set); this file derives the rest and refuses by
# name (rc 2) when no weights directory is named or when flashzoi_opt is not installed on the `python` on PATH (every route, the stock
# route included, goes through the package). Pinned stack: stock/PINS.json "stack" (the package's check reports the running one beside it).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this flashzoi/ directory (the package locates the kit through it)
if [ -n "${FLASHZOI_WEIGHTS:-}" ]; then                                                                              # the hub cache: models--johahi--flashzoi-replicate-{0,1,2,3}/snapshots/<revision>/ directly under it (revisions + sha256 in stock/PINS.json)
  export FLASHZOI_WEIGHTS
  export HF_HUB_CACHE=${HF_HUB_CACHE:-$FLASHZOI_WEIGHTS}                                                            # huggingface_hub's cache directory: Borzoi.from_pretrained(revision=<pin>) resolves offline under it
  export HF_HOME=${HF_HOME:-$(dirname "$FLASHZOI_WEIGHTS")}                                                        # upstream's home variable (its default cache would be $HF_HOME/hub; HF_HUB_CACHE above names ours)
fi
[ -n "${HF_HUB_CACHE:-}${HF_HOME:-}" ] || { echo "[flashzoi-opt] NOT ACTIVE: FLASHZOI_WEIGHTS is not set — see README Variables (the huggingface hub-cache directory that holds models--johahi--flashzoi-replicate-{0,1,2,3}/snapshots/<revision>/; HF_HUB_CACHE or HF_HOME may be exported instead)" >&2; return 2 2>/dev/null || exit 2; }
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1                                                                  # nothing is fetched at run time
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the tree
python -c "import flashzoi_opt" 2>/dev/null || { echo "[flashzoi-opt] NOT ACTIVE: flashzoi_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2; }
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then
  MODEL_OPT_STACK_KEY=$(python -c "from flashzoi_opt.modes import jit_cache_key; print(jit_cache_key())" 2>/dev/null)   # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.5.1-cu124-sm90
  [ -n "$MODEL_OPT_STACK_KEY" ] || { echo "[flashzoi-opt] NOT ACTIVE: MODEL_OPT_STACK_KEY could not be derived (flashzoi_opt.modes.jit_cache_key not importable on $(command -v python || echo 'python (not on PATH)')): set MODEL_OPT_STACK_KEY explicitly, or fix the install" >&2; return 2 2>/dev/null || exit 2; }
fi
export MODEL_OPT_STACK_KEY                                                                                           # the running torch+CUDA+arch: the key of a persistent JIT cache (STOCK.md "Variables")
if [ -z "${TRITON_CACHE_DIR:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then TRITON_CACHE_DIR=$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton; fi   # the optional shared JIT-cache root: <root>/<stack key>/triton (an explicit TRITON_CACHE_DIR wins)
if [ -n "${TRITON_CACHE_DIR:-}" ]; then export TRITON_CACHE_DIR; fi                                                 # Triton JIT cache: the named directory (the kernels compile there once and load thereafter), else Triton's own default (~/.triton/cache)
