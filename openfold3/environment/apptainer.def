# OpenFold3 optimization kit — Apptainer / Singularity image made FROM the container image of openfold3/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged openfold3-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/openfold3-kit:<tag>`.
#   apptainer build openfold3.sif openfold3/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --env OPENFOLD3_CKPT=/weights/of3-p2-155k.pt --bind "$PWD/out":/out openfold3.sif \
#     pred --config h100 --mode fast --query-json /kit/openfold3/stock/src/examples/example_inference_inputs/query_ubiquitin.json --output-dir /out/fast \
#       --use-msa-server false --use-templates false
# The image is read-only: give every verb an --output-dir / --out on a bound, writable path; the JIT caches go under $HOME/.cache and $HOME/.triton
# (bound by default) or under MODEL_OPT_JIT_ROOT when you set it; %environment keeps a host user site-packages (PEP 370) from shadowing the pinned
# stack, --cleanenv keeps the host's variables out.
Bootstrap: docker-daemon
From: openfold3-kit:dev

%environment
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%post
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%runscript
    cd /kit/openfold3 && exec bash /kit/openfold3/run.sh "$@"

%help
    OpenFold3 optimization kit: drop-in modes that make stock OpenFold3 0.4.1 (`run_openfold predict`, OpenFold3 preview-2 weights) faster and
    lighter on GPU memory without changing how it is called — off = stock exactly; exact = identical outputs, faster; fast = small documented numeric
    differences, faster still (the default); big = lowest memory for large inputs (+ --n_gpu P). `apptainer run --nv openfold3.sif <verb> ...` =
    `bash /kit/openfold3/run.sh <verb> ...` (verbs: install, pred, check, warm; /kit/openfold3/README.md inside the image). Requires an NVIDIA
    driver that runs CUDA 12.8 (570 or newer) and OPENFOLD3_CKPT naming the weights file.
