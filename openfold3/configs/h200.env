# H200 (141 GB, compute capability 9.0 — the SAME capability key as H100) deployment parameters (one GPU; `--n_gpu 2|4|8` row-shards `big` over P cards). The mode is NOT here: it comes from `--mode` or OPENFOLD3_OPT
# (the GPU count from `--n_gpu` or OPENFOLD3_OPT_N_GPU); no lever switch is written in this file — the mode table is opt/openfold3_opt/modes.py. usage:
# `run.sh pred|check|warm --config h200 --mode <mode> ...`, or `source configs/h200.env` before calling the package directly. Every value can be pre-set in the environment; this file fills
# what is unset. It refuses (rc 3, NOT ACTIVE) when openfold3_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the
# package). Pinned stack: python 3.11.5, torch 2.10.0+cu128, triton 3.6.0 (stock/PINS.json "pinned_stack").
# Per-card differences from configs/h100.env — the complete list; anything not named here is the identical code path and lever set on both cards:
#   1. image: the H100 image unchanged (sm_90; on this card deepspeed's DS4Sci evoformer_attn op (the stock configuration under --det 0) must be compiled with sm_90 in TORCH_CUDA_ARCH_LIST (environment/Dockerfile DS4SCI_ARCHS)).
#   2. every Triton cell table is keyed by compute capability, and H200 is capability 9.0: the fast line's pair cells (opt_core attn/pair_fused_cells.json,
#      the core's fpf_trimul_v4 table (opt_core/kernels/fpf_trimul_v4/table.json)), the flash triangle attention (opt_core kernels/flash_triattn.py) and the tp line's row-block kernels serve EXACTLY the H100
#      cells — no H200-specific row exists or is read (the tables have no memory-size key).
#   3. big --n_gpu P: the same chunk plan (the 80 GB-card table, tp.CHUNK_PLAN); the card's larger memory is headroom, not a different plan.
# H200 uses the H100 settings and the identical code path, lever for lever; behaviour on H100 is unchanged (the ACTIVE line's card_support= field names the card's class).
# A lever of a mode that cannot engage on a card is an error (exit 3, named — a mode is all of its levers on the card, there is no opt-out), never a silent downgrade;
# documented size/shape gates keep their census words and exit 0.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this openfold3/ directory (the package locates the add-ons through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0); check/pred report a mismatch
# OPENFOLD3_CKPT is not filled here: the pinned weights are of3-p2-155k.pt, sha256 3ae79a70… (stock/PINS.json "weights"),
# and every route hashes the file it is given against that digest (one WEIGHTS line: pinned, or an unknown-checkpoint WARNING — every mode proceeds, labelled weights_pinned=false).
# Set OPENFOLD3_CKPT (or pass --ckpt) to the pinned bytes; a file with another digest is refused or labelled by route.
[ -n "${OPENFOLD3_CKPT:-}" ] && export OPENFOLD_CACHE=${OPENFOLD_CACHE:-$(dirname "$OPENFOLD3_CKPT")}                     # upstream's checkpoint cache root (openfold3/entry_points/parameters.py); unused when --inference-ckpt-path is given
_of3_err=$(python -c "import openfold3_opt" 2>&1 >/dev/null) || { _of3_rc=$?; case "$_of3_err" in *"ModuleNotFoundError: No module named 'openfold3_opt'"*) echo "[openfold3-opt] NOT ACTIVE: reason=package_missing: openfold3_opt is not importable on $(command -v python || echo 'python (not on PATH)') (${_of3_err##*$'\n'}): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3 ;; esac; printf '%s\n' "$_of3_err" >&2; return "$_of3_rc" 2>/dev/null || exit "$_of3_rc"; }   # the package itself (imports nothing of the core). `package_missing` names ONLY a ModuleNotFoundError of openfold3_opt; every other failure — the installed .pth hook's by-name refusal at interpreter start under an exported OPENFOLD3_OPT* (undeclared variable / unknown mode / the core pin gate / producer probe: rc 3) or any import error — is forwarded verbatim with the interpreter's own exit code, never re-diagnosed
python -c "import openfold3_opt._core_gate as g, os; g.gate(os.path.dirname(os.path.abspath(g.__file__)), tag='openfold3-opt')" || { return 3 2>/dev/null || exit 3; }   # the core pin gate (openfold3_opt/_core_gate.py = the house template): an absent or mismatched opt_core is its NOT ACTIVE line, rc 3, before anything else runs
unset _of3_err _of3_rc
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -c "from openfold3_opt.modes import jit_cache_key; print(jit_cache_key())") || { echo "[openfold3-opt] NOT ACTIVE: reason=core_missing: the JIT cache key probe (openfold3_opt.modes.jit_cache_key) failed on $(command -v python || echo 'python (not on PATH)')" >&2; return 3 2>/dev/null || exit 3; }; fi; export MODEL_OPT_STACK_KEY   # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.10.0-cu128-sm90
# MODEL_OPT_JIT_ROOT (optional): a persistent root for the compiled-kernel cache. When set, the cache is keyed by the running stack under it —
# TRITON_CACHE_DIR=<root>/<MODEL_OPT_STACK_KEY>/triton (the Triton kernels of `fast`) — unless it is pre-set; when unset
# nothing is exported and Triton uses its own default (~/.triton/cache).
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}   # torch cpp-extension builds (the fused transition extension of `fast`) under the same key
fi
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
