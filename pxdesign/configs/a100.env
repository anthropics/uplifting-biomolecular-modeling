# A100 deployment parameters (compute capability 8.0; the 80 GB and the 40 GB card alike — no variable here and nothing in the package reads
# the card's memory size, only the largest target that fits differs): configs/h100.env's parameters — the same variables, probes, refusals and
# JIT-cache keying (MODEL_OPT_STACK_KEY is derived from the running stack on either card: torch<version>-cu<CUDA>-sm80 here, so upstream's
# fast-LayerNorm extension builds under its own key) — with this card's one value, the target-GPU word, set first. The mode is NOT here
# (`--mode` or PXDESIGN_OPT=exact|fast|big|off). usage: `run.sh design|check|warm --config a100 --mode <mode> ...`, or `source configs/a100.env`
# before `pxdesign infer ...`. check reports a mismatch between the word and the visible GPU by name, never refuses.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0); check reports a mismatch
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"                                                                            # keep this line last: configs/h100.env's refusals (its return codes) are this file's
