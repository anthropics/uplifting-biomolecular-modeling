# H100 deployment parameters (configs/a100.env is the A100's: this file with its target-GPU word). The mode is NOT here: it comes from `--mode` or PXDESIGN_OPT=exact|fast|big|off.
# usage: `source configs/h100.env` then `PXDESIGN_OPT=exact pxdesign infer ...` (the installed pxdesign_opt package activates on import),
#        or `run.sh design|check|warm --config h100 --mode exact ...`. PXDESIGN_CKPT_DIR and PROTENIX_DATA_ROOT_DIR must be set (README.md Setup; STOCK.md Variables): an unset one is refused by name (rc 3, nothing run). Every other value can be pre-set; this file fills what is unset.
# The verbs need pxdesign_opt and the opt_core it pins (opt/pyproject.toml [tool.opt_core]) importable by the `python` on PATH (installed, or both on PYTHONPATH): this file's first
# python lines refuse (rc 3) when the package is not importable or the core pin gate (`pxdesign_opt.core_gate()`: [pxdesign-opt] NOT ACTIVE: reason=...) refuses, so stock never runs silently.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this pxdesign/ directory (the package locates the lever kit through it)
PXDESIGN_OPT= python -c "import pxdesign_opt" 2>/dev/null || { echo "h100.env: pxdesign_opt is not importable on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt (or both on PYTHONPATH)" >&2; return 3 2>/dev/null || exit 3; }   # importability only: PXDESIGN_OPT neutralised so the installed .pth stays inert on this silenced probe
python -c "import pxdesign_opt as k; k.core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                    # the core pin gate, before any other probe: [pxdesign-opt] NOT ACTIVE: reason=... (rc 3) on an absent or mismatched opt_core
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check reports a mismatch
export PXDESIGN_CKPT_DIR=${PXDESIGN_CKPT_DIR:-}; case "$PXDESIGN_CKPT_DIR" in "") echo "[pxdesign-opt] NOT ACTIVE: PXDESIGN_CKPT_DIR is not set (the directory holding pxdesign_v0.1.0.pt and the three Protenix companion checkpoints; README.md, Weights and Variables): set PXDESIGN_CKPT_DIR" >&2; return 3 2>/dev/null || exit 3 ;; esac   # weights: pxdesign_v0.1.0.pt (sha256 in stock/PINS.json); passed as --load_checkpoint_dir on every arm; no default (a deployment names its own copy)
export PROTENIX_DATA_ROOT_DIR=${PROTENIX_DATA_ROOT_DIR:-}; case "$PROTENIX_DATA_ROOT_DIR" in "") echo "[pxdesign-opt] NOT ACTIVE: PROTENIX_DATA_ROOT_DIR is not set (the CCD cache directory: components.v20240608.cif, components.v20240608.cif.rdkit_mol.pkl, clusters-by-entity-40.txt; README.md, Weights and Variables): set PROTENIX_DATA_ROOT_DIR" >&2; return 3 2>/dev/null || exit 3 ;; esac   # the CCD cache (3 files, stock/PINS.json ccd_cache; read by protenix at import of the data pipeline); upstream's own variable; no default
export MODEL_OPT_STACK_KEY=${MODEL_OPT_STACK_KEY:-$(python -c "from pxdesign_opt.modes import jit_cache_key; print(jit_cache_key())" 2>/dev/null)}; case "$MODEL_OPT_STACK_KEY" in "") echo "[pxdesign-opt] NOT ACTIVE: MODEL_OPT_STACK_KEY could not be derived (modes.jit_cache_key(): a part of torch<version>-cu<cuda>-sm<cc> cannot be established on this box): set MODEL_OPT_STACK_KEY explicitly" >&2; return 3 2>/dev/null || exit 3 ;; esac   # JIT cache key torch<version>-cu<cuda>-sm<cc> (the package's derivation, modes.jit_cache_key; a part it cannot establish is refused, never rendered), e.g. torch2.3.1-cu121-sm90
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then for _v in TORCH_EXTENSIONS_DIR; do eval "_d=\${$_v:-}"; if [ -n "$_d" ] && ! [ -d "$_d" ] && ! [ -d "$(dirname "$_d")" ]; then unset "$_v"; fi; done; unset _v _d; fi   # MODEL_OPT_JIT_ROOT (optional): a shared JIT/compile-cache root; when set, the two build directories below are keyed under it as <root>/$MODEL_OPT_STACK_KEY/<cache> (a pre-set directory is kept when it or its parent exists; one inside an absent tree is replaced by the keyed one); when unset nothing is exported here and each tool uses its own default
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}; fi        # upstream's fast-LayerNorm extension build (protenix/model/layer_norm/torch_ext_compile.py), keyed by the running stack; unset = torch's own default ($XDG_CACHE_HOME or ~/.cache, torch_extensions/)
export LAYERNORM_TYPE=${LAYERNORM_TYPE-fast_layernorm} PYTHONDONTWRITEBYTECODE=1                                    # stock's LayerNorm setting (Protenix reads it at import: protenix/openfold_local/model/primitives.py:49): fast_layernorm unless the caller set the variable — a set value, even empty, is kept (mode off passes it to stock as is; empty or any other value = OpenFold's LayerNorm); no .pyc in the mounted tree
