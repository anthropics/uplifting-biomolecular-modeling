# opt_core autoload guard: package=pxdesign_opt env=PXDESIGN_OPT tag=pxdesign-opt exit=3
import os as _o, sys as _s; exec("try:\n import pxdesign_opt._autoload\nexcept SystemExit as _x:\n _s.stderr.flush(); _o._exit(_x.code if isinstance(_x.code, int) else 3)\nexcept BaseException as _e:\n if (_o.environ.get('PXDESIGN_OPT') or '').strip().lower() not in ('', 'off'):\n  _s.stderr.write('[pxdesign-opt] NOT ACTIVE: pxdesign_opt._autoload is not importable (%s: %s) under PXDESIGN_OPT=%s (exit 3)\\n' % (type(_e).__name__, _e, _o.environ.get('PXDESIGN_OPT'))); _s.stderr.flush(); _o._exit(3)\n")
