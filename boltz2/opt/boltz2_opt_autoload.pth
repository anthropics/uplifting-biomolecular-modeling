# opt_core autoload guard: package=boltz2_opt env=BOLTZ2_OPT tag=boltz2-opt exit=3
import os as _o, sys as _s; exec("try:\n import boltz2_opt._autoload\nexcept SystemExit as _x:\n _s.stderr.flush(); _o._exit(_x.code if isinstance(_x.code, int) else 3)\nexcept BaseException as _e:\n if (_o.environ.get('BOLTZ2_OPT') or '').strip().lower() not in ('', 'off'):\n  _s.stderr.write('[boltz2-opt] NOT ACTIVE: boltz2_opt._autoload is not importable (%s: %s) under BOLTZ2_OPT=%s (exit 3)\\n' % (type(_e).__name__, _e, _o.environ.get('BOLTZ2_OPT'))); _s.stderr.flush(); _o._exit(3)\n")
