# A100 deployment parameters (mirrors configs/h100.env; the two differ only in the target label and these header lines). The mode is NOT here: it comes from `--mode` or BOLTZ2_OPT, and the lever
# switches of every mode live in one place, opt/boltz2_opt/modes.py. usage: `run.sh pred|check|warm --config a100 --mode <mode> ...`,
# or `source configs/a100.env` before calling the package directly. Every variable is read from the environment (STOCK.md "Variables"); this
# file carries no path default: BOLTZ_CACHE is the caller's to set (unset or incomplete, every route refuses by name), TRITON_CACHE_DIR passes
# through (or is keyed under MODEL_OPT_JIT_ROOT when that is set), the non-path settings below are filled when unset. It refuses (rc 2) when
# boltz2_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package), rc 3 when the
# package's shared core is absent or older (`[boltz2-opt] NOT ACTIVE: reason=core_missing:<module>`) or the JIT-cache key probe fails; the
# hook's own refusal of an undeclared BOLTZ2_OPT* name passes through as itself (rc 3), and the mode value is the route's, not this probe's.
# Tested on: NVIDIA A100 80GB PCIe (compute capability 8.0, 81920 MiB); the same pinned stack as h100.env (python 3.11, torch 2.12.0+cu130, triton 3.7.0, cuequivariance 0.10: stock/PINS.json pinned_stack, environment/requirements.lock) — one image serves both cards (the cu130 wheels carry sm_80 and sm_90 SASS; the kit's Triton cells compile per card into the stack-keyed JIT cache, …-sm80).
# Per-card differences on compute capability 8.0 — the complete list; anything not named here runs exactly as on H100 (same code path, same
# lever set, same cells resolved by capability); every mode's row carries every lever it carries on H100 but the ones named `card_off` below. The kit decides them in one place each and names them on its lines:
#   exact   card_off (modes.CARD_DROPS, `card_off=<lever>:<reason>` on the ACTIVE line, one `state=off` LEVER line each): msa_pwa_exact:pin:cc80 only; dit_smx / dit_glue / msa_trans2_exact prove their bits per class at run time here as on H100.
#   exact   pairblock serves under a ROW RULE of the flattened call and runs the stock statements outside it, by name (boltz2_opt.rowfloor; `min_rows=<n> max_rows=<n> piece_rows=<n>`
#           + `fallback_by=below_min_rows:<k>|above_max_rows:<k>|trailing_piece:<k>` + `pieces=<n> trailing=<rows>` of the last pieced call on the lever's line; an input wholly outside idles the lever, `served=0`, exit 0):
#             fused_transition  no kit row rule: the core transition provider's `exact` TIER word decides per (card, stack, N) from its measured table (opt_core.kernels.transition TRANSITION_CELLS: row v1 fed
#                               the module's own LayerNorm output is vouched bitwise on this card's stack, A100:torch2.12.0+cu130/3.7.0, at every measured size 20..2,048 tokens incl. 1,024 / 1,025 / 1,449 and flat calls of
#                               32..65,536 rows); where the table holds no vouch for a stack / size the module's own forward serves BY NAME (`fallback_by=exact_unvouched:<k>`), a cell whose exact winner is the statement `core_stock:<k>`.
#             pairblock         [5,857, 3,145,632) rows = inputs of 77..1,773 tokens (pairblock.py CARD_ROWS): the stock block's 128->128 projections sum in another order at
#                               1,665..3,264 and 5,631..5,856 rows (the 128->4 pair bias below 17), and cuBLAS on this card works a call of 1,048,544 (2**20-32) rows or more in pieces of that many rows whose trailing piece (rows mod 1,048,544 rows) must clear the floor 5,857 too (1,024..1,026 / 1,449 / 1,450 tokens run the original forward, `trailing_piece`).
#   exact   fpf_trimul_exact: the TriMul is the core provider's `exact` tier word here as on H100 — per cell its vouched exact-class kernel row through its face or the library op by the engine's own call, BY NAME (`fallback_by=library_op:cueq:<n>`); on this card the provider's table names the library op for every C=128 / C=64 cell of the pinned stack: the lever idles (`served=0 idle=True gate=ok`), the bytes are `--mode off`'s.
#   fast, big   triangle attention: the PAIRFUSE driver's site asks the shared core's provider by TIER word (`triatt=core.fast` / `core.big`), which names THIS card's row per token count (`CORE-CELL site=triatt ... row=<row>`: the core's measured 8.0 cells — its CUDA row's sm_80 member or its Triton cell — data, not kit code); no lever leaves these rows on this card.
#   fast, big   fpf_opm row `a2` (fpf_msa/opm.py _CFG_BY_CC: pointer loads, BK 64, BZ 16, 3 stages = 147,456 B of shared memory; the H100 rows need 198,656 B > this card's
#                 166,912 B) with a size floor of 385 tokens (msa_kernels.py CARD_MIN_TOKENS: below it the stock module runs, census `skipped_by_name:below_min_tokens`, exit 0).
#   fast, big   the TriMul tier words (`fast` / `big`, the class lever's and the pair-track driver's) resolve on the provider's 8.0 cells (its Triton unit's pointer-load launch cells; the 9.0 cells are TMA cells); every mode: the shared core's tables serve their 8.0 rows by capability (data, not kit code) — a lever whose table has no 8.0 row refuses by name (NOT ACTIVE, exit 3; --allow-partial is the one opt-out), never degraded silently.
# ×2|4|8 (big --n_gpu P): unchanged (the sharded line is pure torch + the core's rows); run on this card at ×2 (STOCK.md Cards).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this boltz2/ directory (the package locates the kits through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0; 80 GB or 40 GB); check reports a mismatch
# BOLTZ_CACHE (required; no default here): the Boltz-2 cache directory upstream reads (main.py:262-278) — boltz2_conf.ckpt (sha256 in stock/PINS.json "weights"), boltz2_aff.ckpt, ccd.pkl, mols/, mols.tar; unset or lacking a file, every route refuses by name before any launch (opt/boltz2_opt/stack.py cache_check), nothing is downloaded.
_rc=0; _err=$(env -u BOLTZ2_OPT python -c "import boltz2_opt" 2>&1 >/dev/null) || _rc=$?   # the probe asks whether the package imports, the mode variable unset (the mode belongs to the route)
if [ "$_rc" != 0 ]; then                                                                                            # the import's own words and exit code pass through verbatim — a refusal raised at import (an undeclared BOLTZ2_OPT* name: NOT ACTIVE, rc 3) or any
  if printf '%s' "$_err" | grep -q "^ModuleNotFoundError: No module named 'boltz2_opt'$"; then                    # import-time error is the import's, never this probe's; only the package itself missing is "not installed" (rc 2)
    echo "[boltz2-opt] NOT ACTIVE: boltz2_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; unset _err _rc; return 2 2>/dev/null || exit 2
  fi
  printf '%s\n' "$_err" >&2; _prc=$_rc; unset _err _rc; return "$_prc" 2>/dev/null || exit "$_prc"
fi; unset _err _rc
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                          # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.12.0-cu130-sm90 — through the kit's core pin gate and module check: an absent, mismatched or older shared core refuses here by name (rc 3), a failed probe never becomes a silent 'unknown' key
  _rc=0; _key=$(env -u BOLTZ2_OPT python -c "import boltz2_opt._core_gate as g, boltz2_opt._autoload as a; g.gate(a.__file__, a.TAG); a.require_core(); from boltz2_opt.modes import jit_cache_key; print(jit_cache_key())") || _rc=$?   # the probe's own words (NOT ACTIVE …) reach stderr as themselves
  [ "$_rc" = 0 ] && [ -n "$_key" ] || { echo "[boltz2-opt] NOT ACTIVE: configs/a100.env: the JIT-cache key probe failed (boltz2_opt.modes.jit_cache_key, rc $_rc); exit 3" >&2; unset _key _rc; return 3 2>/dev/null || exit 3; }
  export MODEL_OPT_STACK_KEY=$_key; unset _key _rc
fi
# TRITON_CACHE_DIR (optional): Triton's JIT cache — the flash triangle-attention kernel and the fused cells compile per box; a pre-set value passes through. MODEL_OPT_JIT_ROOT (optional):
# a persistent cache root; when it is set and TRITON_CACHE_DIR is not, the cache is keyed there by the running torch+CUDA+arch: $MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton.
# Both unset: Triton's own default (~/.triton/cache).
if [ -z "${MODEL_OPT_JIT_ROOT:-}" ] && [ -z "${TRITON_CACHE_DIR:-}" ] && [ -d "$MODEL_OPT/.jit" ] && [ -w "$MODEL_OPT/.jit" ]; then     # the image's shipped cache (environment/Dockerfile unpacks a `warm`-produced tree to .jit/ in this
  export MODEL_OPT_JIT_ROOT=$MODEL_OPT/.jit                                                                          # tree): the JIT root when the caller names none and it is writable — a read-only image or a bare
fi                                                                                                                   # checkout (no .jit/) keeps the pass-through behaviour below
if [ -z "${TRITON_CACHE_DIR:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then
  export TRITON_CACHE_DIR=$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton
fi
# MODEL_OPT_WEIGHTS_DIGEST_DIR (optional, unset here): the directory of the weights digest memo weights_digests.json when the deployment wants it elsewhere than the default — the parent of TRITON_CACHE_DIR when set (the stack-key directory above when MODEL_OPT_JIT_ROOT keys it), else BOLTZ_CACHE; a pre-set value passes through unchanged (stack.weights_memo_dir reads it first); a read-only memo directory is named on the WEIGHTS line and the digest is computed afresh
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc written into the tree
