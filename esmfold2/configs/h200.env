# H200 (141 GB, compute capability 9.0) deployment parameters. The mode and the variant are NOT here: they come from `--mode` / `--variant`
# or ESMFOLD2_OPT / ESMFOLD2_VARIANT. usage: `run.sh pred|check|warm --config h200 --variant fast --mode <mode> ...`, or
# `source configs/h200.env` before calling the package directly. Every value can be pre-set in the environment; this file
# fills what is unset — except the weights root HF_HOME, which it never invents (README; pred/warm refuse by name while it is unset). It refuses
# (rc 3, the kit's NOT ACTIVE line) when esmfold2_opt, or the shared core with every module the package imports, is not on the `python` on PATH
# (every route, the stock route included, goes through the package). Pinned stack: python 3.12.10, torch 2.13.0+cu130, triton 3.7.1 + flash-attn,
# transformer-engine, xformers — stock/PINS.json "pinned_stack" + its accelerated layer "image"; the last line makes those accelerated paths REQUIRED
# on this configuration (a box where they are not live is refused, never run slow).
# The fast / big lever set on this class (compute capability 9.0; esmfold2_opt.registry `classes`): every d=256 / hidden=1024 pair Transition is
# served by `t16` through the shared core's transition provider (opt_core.kernels.transition) under the mode's tier word — `fast` in fast, `big`
# in big — whose cell table names the row for this card and stack (the sm_90a row esm_t16 here); t16 takes the place of t15 / t15msa / t10 on this
# class (DRY-RUN / APPLIED say not_for_class=t10,t15,t15msa; their LEVER lines read state=skipped reason=not_for_class:sm90:superseded_by_t16).
# The pair TriMul is `tx` through the shared core's TriMul provider (opt_core.kernels.trimul) under the same tier word on every class: the provider's
# cell table picks the row per card, stack and size (registry STEPS_ASIDE_ON is empty — no lever steps aside by card). The kit's own kernels
# (opt/forward/fast_inference/driver/) are Triton, compiled on first use into the Triton cache (TRITON_CACHE_DIR below when MODEL_OPT_JIT_ROOT is set).
# The card: NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0 — the SAME capability key as the H100: every cell table, kernel row,
# prebuilt binary and lever of this kit is keyed by compute capability (or by the running torch/CUDA stack), so this card reads EXACTLY the H100 entries;
# no memory gate is retuned (the card's larger memory is headroom, not a different plan).
# This file is configs/h100.env restated for the H200: every statement identical except the target-GPU word (and this file's own name in its
# messages); per-card differences from configs/h100.env — the complete list: NONE in any mode's lever set, kernel rows, size gates or refusals.
# H200 uses the H100 settings; behaviour on H100 is unchanged (this file is read only under --config h200).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this esmfold2/ directory (the package locates opt/forward/ through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0); check reports a mismatch
# HF_HOME — the weights root (hub/models--biohub--{ESMFold2,ESMFold2-Fast,ESMC-6B}: snapshots + sha256 in stock/PINS.json): read from the environment, never defaulted here (STOCK.md "Variables")
[ -z "${HF_HOME:-}" ] || export ESMCFOLD_CCD_PATH=${ESMCFOLD_CCD_PATH:-$HF_HOME/hub/models--biohub--ESMFold2/snapshots/1ebf0e3481a5184eb6171d40615c79e384b48796/ccd.pkl}   # CCD pickle (sha256 in stock/PINS.json "ccd"); unset with HF_HOME unset: the library then reads it from the pinned snapshot under HF_HOME
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1                                                                       # nothing is fetched at run time
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the tree (set before the first import below)
python -m esmfold2_opt._core_gate "$MODEL_OPT/opt" >/dev/null || { _ef2_rc=$?; _ef2_probe=0; env $(compgen -e | sed -n 's/^\(ESMFOLD2_OPT[A-Z_0-9]*\)$/-u \1/p') python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('esmfold2_opt') is not None else 41)" 2>/dev/null || _ef2_probe=$?; if [ "$_ef2_probe" -eq 41 ]; then echo "[esmfold2-opt] NOT ACTIVE: esmfold2_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; _ef2_rc=3; fi; return $_ef2_rc 2>/dev/null || exit $_ef2_rc; }   # the kit's core pin gate (the importable opt_core is the pinned one: reason=core_missing|core_mismatch named, rc 3) BEFORE any probe below imports a submodule; a refusal or failure of that interpreter keeps its own stderr and exit code — 'not installed' names only a genuinely absent package (the absence probe's own exit 41: find_spec found nothing, every ESMFOLD2_OPT* name removed)
python -m esmfold2_opt._producers || { return 3 2>/dev/null || exit 3; }                                            # and every core module the package imports is on disk under it (producer_missing named, rc 3)
export MODEL_OPT_STACK_KEY=${MODEL_OPT_STACK_KEY:-$(python -c "from esmfold2_opt.modes import jit_cache_key; print(jit_cache_key())")}   # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.13.0-cu130-sm90 (opt_core.jit_cache; an unknown part reads `unknown` inside the key)
[ -n "${MODEL_OPT_STACK_KEY:-}" ] || { echo "[esmfold2-opt] NOT ACTIVE: the JIT cache key could not be computed (esmfold2_opt.modes.jit_cache_key on $(command -v python)): the Triton cache would not be keyed by the running stack — refused" >&2; return 3 2>/dev/null || exit 3; }   # never an unkeyed cache directory
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                             # MODEL_OPT_JIT_ROOT — the optional persistent JIT-cache root (STOCK.md "Variables"): when set, the Triton JIT cache (every kit kernel is Triton)
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}                          # lives at <root>/<stack key>/triton, keyed by the running torch+CUDA+arch, and the weights digest memo at <root>/weights; when unset nothing
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}          # torch C++/CUDA extension builds of the shared core's kernels, when a served row compiles one, keyed the same way
  export ESMFOLD2_OPT_WEIGHTS_MEMO_DIR=${ESMFOLD2_OPT_WEIGHTS_MEMO_DIR:-$MODEL_OPT_JIT_ROOT/weights}                   # is exported here: Triton uses its own cache default and the memo esmfold2_opt.stack.weights_memo_dir's. the weights digest memo lives at $ESMFOLD2_OPT_WEIGHTS_MEMO_DIR/weights_digests.json (esmfold2_opt/digest_memo.py: sha256 per file, an entry written only after a full digest; size/mtime/inode select an entry, never decide sameness; `check` digests afresh)
fi
export ESMFOLD2_OPT_REQUIRE_FAST_ENV=${ESMFOLD2_OPT_REQUIRE_FAST_ENV:-1}                                        # fail loud (esmfold2_opt/attn.py): the stock route and every kit arm refuse — rc 3, one NOT ACTIVE sentence naming each failing word and the pinned accelerated layer (stock/PINS.json "image") — unless those accelerated paths are live in the interpreter: atom_attn=flash_attn (upstream's modeling_esmfold2_common.FLASH_ATTN_AVAILABLE), esmc_mlp=te (the fork's modeling_esmc._te_available: transformer-engine's fused LayerNorm+MLP bound in the LM), esmc_rope=flash_attn_triton; never a slow path on this configuration. 0: report the words (atom_attn=sdpa esmc_mlp=torch …) and proceed (other stacks)
