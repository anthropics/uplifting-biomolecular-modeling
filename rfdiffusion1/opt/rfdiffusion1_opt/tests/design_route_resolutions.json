  "exact": {
   "autocast": null,
   "cudnn_tf32": false,
   "matmul": "highest",
   "matmul_tf32": false,
   "policy": "fp32_strict",
   "set_by": "opt/forward/fast_inference/drivers/rfd_bench.py:45-46 (--tf32 0, the driver's default: both TF32 flags off; float32 matmul precision and autocast at torch's defaults, highest / none)"
  },
  "fast": {
   "autocast": null,
   "cudnn_tf32": true,
   "matmul": "highest",
   "matmul_tf32": true,
   "policy": "tf32",
   "set_by": "opt/forward/fast_inference/drivers/rfd_bench.py:45-46 under lever TF32's switch --tf32 1 (both TF32 flags on; float32 matmul precision and autocast at torch's defaults); the SE(3) add-on's Triton dots stay at input_precision=ieee (rfd_se3fast/kernels.py: tl.dot input_precision ieee)"
  },
  "off": {
   "policy": "untouched"
  }
 },
