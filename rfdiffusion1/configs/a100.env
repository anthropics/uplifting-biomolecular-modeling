# A100 deployment parameters (A100 80 GB and A100 40 GB alike, compute capability 8.0): configs/h100.env's parameters — the same variables, probes, refusals and
# JIT-cache keying (MODEL_OPT_STACK_KEY is derived from the running stack on either card: torch2.4.0-cu121-sm80 here) — with this card's one
# value, the target-GPU word, set first. The mode is NOT here (`--mode` or RFDIFFUSION1_OPT).
# usage: `run.sh design|check|warm --config a100 --mode <mode> ...`, or `source configs/a100.env` before calling the package directly. The
# package classes the visible card by compute capability and memory band (rfdiffusion1_opt.stack.GPU_CLASSES: this card is class A100), meets
# the base driver's own H100-name assertion with its documented override on any other card, and check reports a mismatch with the word.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0, class A100 of rfdiffusion1_opt.stack.GPU_CLASSES); check reports a mismatch
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"                                                                            # keep this line last: configs/h100.env's refusals (its return codes) are this file's
