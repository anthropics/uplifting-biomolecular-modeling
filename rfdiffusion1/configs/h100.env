# H100 deployment parameters (configs/a100.env is the A100's: this file with its target-GPU word). The mode is NOT here: it comes from `--mode` or RFDIFFUSION1_OPT
# (default: `fast`; `--mode exact` for byte-equal equality; RFDIFFUSION1_OPT unset leaves the env route inert). usage: `run.sh design|check|warm --config h100 --mode <mode> ...`, or `source configs/h100.env`
# before calling the package directly. The RFdiffusion checkout (RFD_ROOT)
# and the weights directory (WEIGHTS) come from the environment (STOCK.md "Variables"; the package refuses by name when it cannot find them); this
# file fills the rest of what is unset. It refuses (rc 3) only when rfdiffusion1_opt is not importable on the `python` on PATH or its core pin
# gate refuses (opt/rfdiffusion1_opt/_core_gate.py: the installed opt_core is the one opt/pyproject.toml pins; the first two probes below, before any
# other — every route, the stock route included, goes through the package). The pinned stack is stock/PINS.json "pinned_stack" (the version pins and
# the installer; no image id is pinned).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this rfdiffusion1/ directory (the package locates the kits and the stock pins through it)
env -u RFDIFFUSION1_OPT python -c "import rfdiffusion1_opt" 2>/dev/null || { echo "[rfdiffusion1-opt] NOT ACTIVE: rfdiffusion1_opt is not importable on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3; }   # the variable unset on this probe alone (see run.sh)
python -c "import rfdiffusion1_opt as k; from rfdiffusion1_opt.report import TAG; from rfdiffusion1_opt._core_gate import gate; gate(k.__file__, tag=TAG)" >/dev/null || { return 3 2>/dev/null || exit 3; }   # the core pin gate, before any other probe: an absent, older / newer or edited core prints its own `[rfdiffusion1-opt] NOT ACTIVE: reason=core_…` line; rc 3
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check reports a mismatch
if [ -n "${RFD_ROOT:-}" ]; then export RFD_ROOT; fi                                                                   # the editable RFdiffusion checkout (stock/PINS.json "install"; `check` reports it against the pin, stock/check_pins.py); unset: pip's recorded editable install of `rfdiffusion`, else every route refuses naming RFD_ROOT
if [ -n "${WEIGHTS:-}" ]; then export WEIGHTS; fi                                                                     # weights directory: Complex_base_ckpt.pt and Base_ckpt.pt (sha256 + URL in stock/PINS.json "weights"); unset (and no typed inference.model_directory_path): design / warm refuse naming WEIGHTS
if [ -z "${MODEL_OPT_STACK_KEY:-}" ] && [ -n "${TORCH_EXTENSIONS_DIR:-}" ] && [ -d "$(dirname "$(dirname "$TORCH_EXTENSIONS_DIR")")" ]; then export MODEL_OPT_STACK_KEY=$(basename "$(dirname "$TORCH_EXTENSIONS_DIR")"); fi   # a keyed cache layout the environment already carries (<root>/<key>/torch_extensions): its key is the key, computed once by whoever laid it out
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                           # else the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.4.0-cu121-sm90
  if MODEL_OPT_STACK_KEY=$(python -c "from rfdiffusion1_opt.stack import jit_cache_key; print(jit_cache_key())" 2>/dev/null); then export MODEL_OPT_STACK_KEY;   # a stack whose key cannot be derived (a torch
  else unset MODEL_OPT_STACK_KEY; echo "[rfdiffusion1-opt] NOTE: MODEL_OPT_STACK_KEY not derivable on this stack (rfdiffusion1_opt.stack.jit_cache_key): no keyed JIT-cache directory is exported; Triton and torch use their default caches" >&2; fi   # wheel without CUDA metadata) is named and runs on the default caches — a cache key never gates a mode
fi
if [ -z "${TRITON_CACHE_DIR:-}" ] && [ -n "${MODEL_OPT_JIT_ROOT:-}" ] && [ -n "${MODEL_OPT_STACK_KEY:-}" ]; then export TRITON_CACHE_DIR=$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton; fi   # Triton JIT cache (base's fast line: the SE(3) add-on's kernels, lever T2; also the kit's Tier-2 lever K2, reachable through the kit's own driver): a pre-set TRITON_CACHE_DIR is used as is; else, under an optional shared cache root MODEL_OPT_JIT_ROOT, the keyed directory <root>/<key>/triton; neither set: nothing exported, Triton's own default cache
export MODEL_OPT_PACK_WORKER_GB=${MODEL_OPT_PACK_WORKER_GB:-10}                                                       # `design --pack K`: the per-worker device footprint (GB) the packing launcher's memory estimate multiplies (a NOTE when K x it exceeds the card, never a gate)
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc written into the kit tree
