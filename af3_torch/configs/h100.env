# configs/h100.env — deployment parameters for one H100-class box: sourced by run.sh --config h100 (or `source configs/h100.env` before
# `python -m af3_torch_opt ...`). Deployment only: no mode, no lever — the mode table is opt/af3_torch_opt/modes.py and the levers the
# kit's own LEVER_SETS. Every value already set in the environment wins. The two interpreters and the fork checkout (AF3_TORCH_PY,
# AF3_TORCH_JAX_PY, AF3_TORCH_JAX_REPO; STOCK.md "Variables") have NO default: `python -m af3_torch_opt exports` prints one presence check
# per required variable (af3_torch_opt.stack.REQUIRED, the one list) and this file evaluates them — an unset one is named and the config
# returns 3. Refuses (rc 3) likewise unless that probe runs: the package's entry route, so a missing, older or edited shared core is the
# package's own refusal line (core_missing / core_mismatch / producer_missing, rc 3) and never a silently unset variable. The probe runs
# without AF3_TORCH_OPT: the mode variable is the wrapper's to judge, not the probe's.
_RC=0; _ERR=$(mktemp "${TMPDIR:-/tmp}/af3_torch_exports.XXXXXXXXXX") || { echo "configs/${BASH_SOURCE[0]##*/}: refused (rc 3): no private temporary file could be made under ${TMPDIR:-/tmp} (mktemp's words above)" >&2; unset _RC _ERR; return 3 2>/dev/null || exit 3; }   # the probe's stderr goes to a fresh private file (mktemp: a new name, mode 0600), never to a predictable name another account could have planted as a symbolic link
_EXPORTS=$(env -u AF3_TORCH_OPT python -m af3_torch_opt exports 2>"$_ERR") || _RC=$?
if [ "$_RC" -ne 0 ]; then                                                                                                              # the interpreter's own words verbatim, then ONE line, and ITS rc: `not installed` only for a genuine ModuleNotFoundError of the package; a refusal (core_missing / core_mismatch / producer_missing, rc 3) keeps its line and rc
  cat "$_ERR" >&2
  if grep -q "No module named af3_torch_opt" "$_ERR"; then echo "configs/h100.env: af3_torch_opt is not installed on $(command -v python || echo python): pip install -e $(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/common/opt_core -e $(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/opt" >&2; _RC=3
  else echo "configs/h100.env: refused (rc $_RC): \`python -m af3_torch_opt exports\` on $(command -v python || echo python) refused — its words above (core_missing / core_mismatch / producer_missing, or a broken tree)" >&2; fi
  rm -f "$_ERR"; unset _EXPORTS _ERR; return $_RC 2>/dev/null || exit $_RC
fi
rm -f "$_ERR"; unset _RC _ERR
eval "$_EXPORTS"; unset _EXPORTS                                                                                                      # one presence check each, named on failure (return 3): AF3_TORCH_PY (the torch venv: torch 2.13.0+cu130, triton 3.7.1), AF3_TORCH_JAX_PY (the JAX venv: the fork for featurisation + the writers), AF3_TORCH_JAX_REPO (the fork checkout: run_alphafold.py's writers)
export AF3_TORCH_PARAMS_DIR=${AF3_TORCH_PARAMS_DIR:-}                    # the converted OpenFold3-preview2 parameters: NO default — the deployment sets it; unset → the gate names it (stack.py)
_K=torch2.13.0-cu130-sm90                                                              # the shipped-cache tree name for a compute-capability 9.0 card (stack.cache_seed_key); the AF3_TORCH_GPU lines below switch it for A100 and set AF3_TORCH_CACHE_ROOT — JIT caches: <root>/triton, <root>/inductor, <root>/jax (key them by the box's torch/cuda/sm when sharing a root across boxes)
export AF3_TORCH_STOCK_PY=${AF3_TORCH_STOCK_PY:-}                                                                                     # the stock route's interpreter (run.sh stock): NO default — the composed stock venv you build (python -m af3_torch_opt.stock_venv --dest DIR): DIR/bin/python; unset → `stock` names it and exits 3; an interpreter another account owns or could replace is refused by name
export AF3_TORCH_GPU=${AF3_TORCH_GPU:-H100}; [ "$AF3_TORCH_GPU" != A100 ] || _K=torch2.13.0-cu130-sm80                             # the target class (the kit's tested cells: cc 9.0); reported on the ACTIVE line as gpu_target
if [ -z "${AF3_TORCH_CACHE_ROOT:-}" ] && [ -z "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                       # no cache root named and no JIT root exported (this file sourced by hand, without run.sh): a per-user root under the temporary directory, held to the private-directory rule — made 0700 here, used only when it is a directory this user owns, not a symbolic link, not writable by group or others; anything else is refused by name and this shell compiles into a fresh private directory instead
  _R="${TMPDIR:-/tmp}/af3_torch_cache-uid$(id -u)"; mkdir -m 700 "$_R" 2>/dev/null || :
  case $( [ -d "$_R" ] && [ ! -L "$_R" ] && [ -O "$_R" ] && stat -c %a "$_R" 2>/dev/null ) in ''|*[2367]|*[2367]?)
    _P=$(mktemp -d "${TMPDIR:-/tmp}/af3_torch_cache.XXXXXXXXXX" 2>/dev/null) && export AF3_TORCH_CACHE_ROOT="$_P/$_K"
    echo "[af3-torch-opt] configs/${BASH_SOURCE[0]##*/}: $_R refused (another owner, open to group or others, a symbolic link, or not creatable): AF3_TORCH_CACHE_ROOT=${AF3_TORCH_CACHE_ROOT:-<unset>} for this shell" >&2; unset _P ;;
  *) export AF3_TORCH_CACHE_ROOT="$_R/$_K" ;;
  esac; unset _R
fi
export AF3_TORCH_CACHE_ROOT=${AF3_TORCH_CACHE_ROOT:-${MODEL_OPT_JIT_ROOT:+$MODEL_OPT_JIT_ROOT/$_K}}; unset _K                              # an explicit value wins; else <MODEL_OPT_JIT_ROOT>/<that tree> (run.sh exports that root: the image's cache or a private per-user directory); else the per-user root above (left empty only when no private directory can be made: the package's own default under ~/.cache then applies)
