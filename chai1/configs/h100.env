# H100 deployment parameters (the only configuration in this tree). The mode is NOT here: it comes from `--mode`, CHAI1_OPT or the package
# default (opt/chai1_opt/modes.py DEFAULT_MODE); no lever switch and no recipe variable is set here (the mode table is modes.py; the
# recipe is `--det`). usage: `run.sh pred|check|warm --config h100 [--mode <mode>] ...`, or `source configs/h100.env` before
# calling the package directly. Every value can be pre-set in the environment; this file fills what is unset. It
# refuses (rc 2) when chai1_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the
# package). No path is baked in here: the weights directory CHAI_DOWNLOADS_DIR comes from the caller's environment (README, Variables) and the
# package refuses by name when it is unset or incomplete. The pinned stack: stock/PINS.json "stack" (torch 2.13.0+cu130, CUDA 13.0, H100).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this chai1/ directory (the package locates the kit through it)
command -v python >/dev/null || { echo "[chai1-opt] NOT ACTIVE: chai1_opt is not installed: no python on PATH (pip install -e $MODEL_OPT/opt)" >&2; return 2 2>/dev/null || exit 2; }
_PROBE=$(python -c "import chai1_opt" 2>&1 >/dev/null); _RC=$?   # importable? any non-zero exit is the import's own words and code, relayed verbatim (a refusal the package prints at
if [ "$_RC" -ne 0 ]; then                                         # interpreter start — chai1_opt_autoload.pth: an unknown CHAI1_OPT, an undeclared CHAI1_OPT_* variable — exits 3 by name;
  if printf '%s' "$_PROBE" | grep -q "ModuleNotFoundError: No module named 'chai1_opt'"; then   # a broken import keeps its traceback and rc); 'not installed' (rc 2) only for the package's
    echo "[chai1-opt] NOT ACTIVE: chai1_opt is not installed on $(command -v python): pip install -e $MODEL_OPT/opt" >&2; unset _PROBE _RC; return 2 2>/dev/null || exit 2   # own ModuleNotFoundError
  fi
  printf '%s\n' "$_PROBE" >&2; _X=$_RC; unset _PROBE _RC; return "$_X" 2>/dev/null || exit "$_X"
fi
unset _PROBE _RC
python -c "from chai1_opt import _core; _core.entry_gate()" || { return 3 2>/dev/null || exit 3; }   # the pin gate (opt/chai1_opt/_core_gate.py): the shared core absent, stale or older is the package's own NOT ACTIVE line, rc 3, before any probe below imports a submodule
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); every route notes a mismatch on its ACTIVE / DRY-RUN line (notes=...), none refuses
# CHAI_DOWNLOADS_DIR (required, from the caller's environment): the weights — chai-lab's downloads/ layout (models_v2/*.pt, conformers_v1.apkl, esm/*.pt;
# stock/PINS.json "weights"); upstream's own variable; nothing is fetched at run time — unset or incomplete, every verb is NOT ACTIVE by name (chai1_opt.stack.weights_check).
# The package also reads CHAI1_OPT_ESM_MEMO_SCOPE=global|input from the environment (never set by this file; default global): the reach of the
# kit's ESM-embedding memo — `input` recomputes ESM2-3B embeddings for every input exactly as stock does (stock's form), `global`
# memoises across every input of the process (STOCK.md Variables, CHAI1_OPT_ESM_MEMO_SCOPE).
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
