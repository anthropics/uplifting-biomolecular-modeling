# H200 deployment parameters (NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0).
# configs/h100.env's parameters — the same variables, probes, refusals and JIT-cache keying (a stack key derived from the running stack reads
# sm90 on this card, the H100's key: the shipped / warmed caches are shared) — with this card's target-GPU word set first; usage:
# `run.sh <command> --config h200 --mode <mode> ...`, or `source configs/h200.env`. Per-card differences from configs/h100.env — the complete
# list: NONE in any mode's lever set, kernel rows, size gates or refusals; the word below names the card the check / activation lines compare
# (a mismatch is a note, never a refusal). The H200 uses the H100 settings; behaviour on H100 is unchanged (this file is read only under
# --config h200).
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (NVIDIA H200, compute capability 9.0 = the H100's key); check / the activation line report a mismatch with the visible GPU, never refuse
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/h100.env" || { _rc=$?; return "$_rc" 2>/dev/null || exit "$_rc"; }   # configs/h100.env's refusals (its return codes) are this file's
# JIT / ahead-of-time caches: this kit keys $MODEL_OPT_JIT_ROOT/<key>/{triton,inductor,aoti} by the stack AND the config word (opt/chai1_opt/jit.py cache_key);
# the H200 compiles and loads the H100's sm_90a artefacts unchanged, so this config PINS the key to the H100's value: `--config h200` resolves to the
# H100's warmed cache (the compiled denoiser step's packages included), never a cold torch<v>-cu<NNN>-h200 directory. A caller's MODEL_OPT_STACK_KEY wins.
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then
  MODEL_OPT_STACK_KEY=$(python -c 'from chai1_opt.jit import cache_key; print(cache_key(environ={"MODEL_OPT_TARGET_GPU": "h100"}))' 2>/dev/null) || MODEL_OPT_STACK_KEY=""
  if [ -n "$MODEL_OPT_STACK_KEY" ]; then export MODEL_OPT_STACK_KEY
  else unset MODEL_OPT_STACK_KEY; echo "[chai1-opt] NOTE: configs/h200.env: the H100 JIT-cache key could not be computed (chai1_opt.jit.cache_key) — the kit derives its own key (torch<v>-cu<NNN>-h200: a cold directory until \`run.sh warm --config h200\` fills it)" >&2; fi
fi
