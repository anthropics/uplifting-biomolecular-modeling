# opt_core autoload guard: package=complexa_opt env=COMPLEXA_OPT tag=complexa-opt exit=3
import os as _o, sys as _s; exec("try:\n import complexa_opt._autoload\nexcept SystemExit as _x:\n _s.stderr.flush(); _o._exit(_x.code if isinstance(_x.code, int) else 3)\nexcept BaseException as _e:\n if (_o.environ.get('COMPLEXA_OPT') or '').strip().lower() not in ('', 'off'):\n  _s.stderr.write('[complexa-opt] NOT ACTIVE: complexa_opt._autoload is not importable (%s: %s) under COMPLEXA_OPT=%s (exit 3)\\n' % (type(_e).__name__, _e, _o.environ.get('COMPLEXA_OPT'))); _s.stderr.flush(); _o._exit(3)\n")
