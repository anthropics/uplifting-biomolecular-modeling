# H200 deployment parameters (NVIDIA H200, 141 GB, compute capability 9.0); sourced by run.sh --config h200; usable by hand: `source configs/h200.env`.
# It is configs/h100.env's parameters — the same variables, probes, refusals and JIT-cache keying (MODEL_OPT_JIT_KEY is derived from the running
# stack and reads sm90 on this card, as on the H100, so the two cards share compile caches) — with this card's one value, the target-GPU word,
# set first (a word already in the environment is kept). Per-card differences from configs/h100.env: none in any mode's lever set or refusals;
# the word below names the card that check / the activation line compare with the visible GPU (a mismatch is a note, never a refusal).
# H200 uses the H100 settings; behaviour under --config h100 is unchanged (this file is read only under --config h200). Keep the `.` line
# last: configs/h100.env's refusals (return code 3) are this file's.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (NVIDIA H200, compute capability 9.0 = the H100's key); check / the activation line report a mismatch with the visible GPU, never refuse
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"
