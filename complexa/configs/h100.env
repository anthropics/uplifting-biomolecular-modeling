# configs/h100.env — deployment parameters of the H100 box (sourced by run.sh --config h100; usable by hand: `source configs/h100.env`; configs/a100.env is the A100's).
# Nothing here selects a mode or changes a numeric setting: the mode is --mode / COMPLEXA_OPT (modes.py); a pass's knobs are upstream's own Hydra overrides after `--` (settings.py).
# Upstream's own variables are read from the environment (STOCK.md 'Variables'). The two that name this box's paths carry no default here:
# LOCAL_CODE_PATH (upstream's checkout) and CKPT_PATH (the two checkpoints) — unset, this file names them on stderr and design / check refuse
# by name (exit 3). The rest default to values that hold on any machine (derived from the checkout, the kit's state directory, or inert stubs).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this complexa/ directory (the package locates stock/ through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check prints target=/match= and design records the GPU found — a report on the stock routes, never a gate
export MODEL_OPT_STATE=${MODEL_OPT_STATE:-${HOME:-/root}/.cache/complexa_opt}                                        # out-of-tree state: AF2_DIR below defaults under it
[ -z "${LOCAL_CODE_PATH:-}" ] || export LOCAL_CODE_PATH                                                              # upstream's checkout at the pin (upstream's own variable; no default): configs/search_binder_local_pipeline.yaml is read from it and proteinfoundation is installed editable from it
[ -z "${CKPT_PATH:-}" ] || export CKPT_PATH                                                                          # the directory holding the pinned checkpoints (no default; stock/PINS.json "weights": complexa.ckpt 589db174…, complexa_ae.ckpt 35f8865e…; `run.sh install --weights DIR` fetches them): passed as ++ckpt_path / ++autoencoder_ckpt_path
export COMPLEXA_INIT=${COMPLEXA_INIT:-1}                                                                             # upstream's CLI refuses to run before `complexa init` unless set (cli_runner.py)
if [ -n "${LOCAL_CODE_PATH:-}" ]; then                                                                                # upstream's two checkout-relative variables (unused by the generation stage, resolved eagerly by Hydra): derived from the checkout when unset
  export COMMUNITY_MODELS_PATH=${COMMUNITY_MODELS_PATH:-$LOCAL_CODE_PATH/community_models}                           # reward / community models
  export DATA_PATH=${DATA_PATH:-$LOCAL_CODE_PATH/assets/target_data}                                                 # shipped targets (a pass's target_path is absolute)
fi
export AF2_DIR=${AF2_DIR:-$MODEL_OPT_STATE/af2_params}                                                               # upstream's variable: the parameter directory of the structure-prediction reward model its shipped best-of-n search scores designs with (Hydra resolves the name eagerly on every run; a generation-stage run — ++generation.reward_model=null — never reads the directory)
for _v in ESM_DIR RF3_CKPT_PATH RF3_EXEC_PATH FOLDSEEK_EXEC MMSEQS_EXEC DSSP_EXEC SC_EXEC; do                          # upstream's optional reward / evaluation tools, stubbed with /bin/true when unset (Hydra resolves ${oc.env:…} eagerly; the shipped generation pipeline calls none — name the real paths to use them)
  [ -n "${!_v:-}" ] || export "$_v=/bin/true"
done
unset _v
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree or the checkout
python -c "import complexa_opt" 2>/dev/null || { echo "[complexa-opt] NOT ACTIVE: complexa_opt is not installed on $(command -v python || echo 'python (not on PATH)'): $MODEL_OPT/run.sh install (= pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt)" >&2; return 3 2>/dev/null || exit 3; }
python -c "from complexa_opt import core_gate; core_gate()" >/dev/null || { return 3 2>/dev/null || exit 3; }                    # the core pin gate before any other probe: an absent / older / newer / edited shared core is its one NOT ACTIVE line, status 3
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                           # torch<version>-cu<CUDA> of the running python from distribution metadata (no torch import), e.g. torch2.7.0-cu126; a label the manifest records
  MODEL_OPT_STACK_KEY=$(python -c "from complexa_opt import stack; print(stack.stack_key())" 2>/dev/null || echo unknown); export MODEL_OPT_STACK_KEY
fi
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                            # optional shared JIT / compile-cache root (STOCK.md 'Variables'): <root>/<MODEL_OPT_JIT_KEY>/{triton,torch_ext}, each unless already set; unset → nothing exported here, the tools' own defaults apply (the generation stage builds no extension)
  if [ -z "${MODEL_OPT_JIT_KEY:-}" ]; then                                                                           # torch<version>-cu<CUDA>-sm<cc> of the running stack (complexa_opt.stack.jit_key, the core's key rule: distribution metadata + nvidia-smi, no torch import) — torch2.7.0-cu126-sm90 on this card at the pin; a pre-set key is kept; a part this box cannot establish (no torch metadata, no GPU visible) makes the key the word `unknown`, named on stderr, the caches keyed under <root>/unknown/ (a directory no pinned stack shares) — nothing is refused over it
    MODEL_OPT_JIT_KEY=$(python -c "from complexa_opt import stack; print(stack.jit_key())") || MODEL_OPT_JIT_KEY=unknown # the probe's own failure is the same word, never a stop
  fi
  export MODEL_OPT_JIT_KEY
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_JIT_KEY/torch_ext}
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_JIT_KEY/triton}
fi
if [ -z "${LOCAL_CODE_PATH:-}" ]; then echo "[complexa-opt] configs/h100.env: LOCAL_CODE_PATH is not set — it names upstream's Proteina-Complexa checkout at the pin (README 'Variables'); design and check refuse without it" >&2
elif [ ! -f "$LOCAL_CODE_PATH/configs/search_binder_local_pipeline.yaml" ]; then echo "[complexa-opt] configs/h100.env: LOCAL_CODE_PATH=$LOCAL_CODE_PATH holds no configs/search_binder_local_pipeline.yaml (design and check refuse without upstream's checkout)" >&2; fi
if [ -z "${CKPT_PATH:-}" ]; then echo "[complexa-opt] configs/h100.env: CKPT_PATH is not set — it names the directory holding complexa.ckpt + complexa_ae.ckpt (README 'Variables'); design and check refuse without it" >&2
elif [ ! -f "$CKPT_PATH/complexa.ckpt" ] || [ ! -f "$CKPT_PATH/complexa_ae.ckpt" ]; then echo "[complexa-opt] configs/h100.env: CKPT_PATH=$CKPT_PATH does not hold complexa.ckpt + complexa_ae.ckpt (design and check refuse without the pinned checkpoints)" >&2; fi
command -v complexa >/dev/null || echo "[complexa-opt] configs/h100.env: upstream's console script 'complexa' is not on PATH (pip install -e \$LOCAL_CODE_PATH)" >&2
