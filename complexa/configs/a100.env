# configs/a100.env — deployment parameters of an A100 box (compute capability 8.0, the 80 GB and the 40 GB card alike: neither this file nor the
# package reads the card's memory size; what a design run needs grows with the target's size × the dataloader batch, and the batch is the caller's
# own Hydra override — `++generation.dataloader.batch_size=<B>` after `--`, 16 as shipped, README.md 'Run'); sourced by run.sh --config a100; usable by hand:
# `source configs/a100.env`. It is configs/h100.env's parameters — the same variables, probes, refusals and JIT-cache keying (MODEL_OPT_JIT_KEY is
# derived from the running stack on either card: torch2.7.0-cu126-sm80 on this one at the pin) — with this card's one value, the target-GPU word,
# set first (a word already in the environment is kept, as every variable of these files keeps a launcher's value). Nothing here selects a mode
# (`--mode` / COMPLEXA_OPT) or a sampling value. check prints target=/match= against the core's class table (opt_core.gates.GPU_CLASSES: the
# card's name and memory size) and design records the GPU found — a report on the stock routes, never a gate. Keep the `.` line last:
# configs/h100.env's refusals (return code 3) are this file's.
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0; 80 GB or 40 GB)
. "$(dirname "${BASH_SOURCE[0]}")/h100.env"
