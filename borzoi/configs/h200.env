# H200 deployment parameters: non-path settings only. The mode is NOT here: it comes from `--mode` or
# BORZOI_OPT. usage: `run.sh sad|check --config h200 --mode <mode> ...`, or `source configs/h200.env` before calling the package directly.
# Every value can be pre-set in the environment; this file fills what is unset. No path is defaulted here: the stock checkout (BORZOI_DIR —
# upstream's own variable; else borzoi_sad.py on PATH) is read from the environment by the package, which refuses by name when it needs it and
# it is unset; the weights, params, targets, genome and VCF of a `sad` job are the stock command's own arguments (README.md "Variables", "Inputs").
# It refuses (rc 2) when borzoi_opt is not installed on the `python` on PATH (every route, the stock route included, goes through the package).
# Pinned stack: stock/PINS.json "pinned_stack" (python, tensorflow, numpy, h5py versions).
# The card: NVIDIA H200, compute capability 9.0 — the H100's capability. This kit's levers are host-side or dispatch-only and none is
# keyed by card, so the H200 uses the H100 settings: this file is configs/h100.env with the target-GPU word changed (and this file's own
# name in its messages); the lever set, gates and refusals are identical in every mode, and behaviour on H100 is unchanged (this file is
# read only under --config h200).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this borzoi/ directory (the package locates the kit through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0); check reports a mismatch
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the kit tree
python -c "import borzoi_opt" 2>/dev/null || { echo "[borzoi-opt] NOT ACTIVE: borzoi_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; return 2 2>/dev/null || exit 2; }
