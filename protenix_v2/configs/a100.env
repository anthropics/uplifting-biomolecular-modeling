# A100 (80 GB, compute capability 8.0) deployment parameters. The mode is NOT here: it comes from `--mode` or PROTENIX_OPT=exact|fast|big|off.
# usage: `source configs/a100.env` then `PROTENIX_OPT=exact protenix pred ...` (the installed protenix_opt package activates at interpreter start),
#        or `run.sh pred|check|warm --config a100 --mode exact ...`. Every value can be pre-set in the environment; this file fills what is unset,
#        except PROTENIX_ROOT_DIR (the weights root), which has no default: unset, this file refuses by name (rc 3). MODEL_OPT_JIT_ROOT (optional) is
#        a persistent cache root: set, the JIT caches and the kit's cache root are exported under it; unset, nothing is exported for them and each tool
#        keeps its own default. STOCK.md 'Variables' lists them all.
# The drop-in route works only with protenix_opt installed on the `python` on PATH: this file refuses (rc 2) when it is not, so stock never runs silently;
# an interpreter that itself refuses to start (the kit's start-up gate on an undeclared PROTENIX_OPT* name, exit 3) is reported in its own words with its own code.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this protenix_v2/ directory (the package locates opt/ through it)
# Presence probe (find_spec executes nothing of the package): 41 = genuinely absent -> 'not installed', rc 2 (127/126: no usable python on PATH, rc 2); any other
# non-zero exit is the interpreter's own start-up refusal (the kit's hook: an undeclared PROTENIX_OPT* name, exit 3) - printed verbatim, and this file returns ITS code.
_ptx_probe_rc=0; _ptx_probe_err=$(env -u PROTENIX_OPT -u PROTENIX_OPT_N_GPU -u PROTENIX_OPT_TP_ROUTE python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('protenix_opt') else 41)" 2>&1 >/dev/null) || _ptx_probe_rc=$?
if [ "$_ptx_probe_rc" -eq 41 ] || [ "$_ptx_probe_rc" -eq 127 ] || [ "$_ptx_probe_rc" -eq 126 ]; then
  echo "[protenix-opt] NOT ACTIVE: protenix_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; unset _ptx_probe_rc _ptx_probe_err; return 2 2>/dev/null || exit 2
elif [ "$_ptx_probe_rc" -ne 0 ]; then
  [ -n "$_ptx_probe_err" ] && printf '%s\n' "$_ptx_probe_err" >&2
  echo "[protenix-opt] NOT ACTIVE: $(command -v python) exited $_ptx_probe_rc before the protenix_opt probe could run (its words above)" >&2
  _r=$_ptx_probe_rc; unset _ptx_probe_rc _ptx_probe_err; return "$_r" 2>/dev/null || exit "$_r"
fi
unset _ptx_probe_rc _ptx_probe_err
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (compute capability 8.0); check/pred report a mismatch
# Per-card differences from configs/h100.env, by lever name — anything not listed is bound as on H100. Nothing below is keyed on the card's
# memory size: the 40 GB and 80 GB parts differ only in what fits, and the memory-derived policies print their own values.
#  - The lever set of each mode on this card is the cc-8.0 row of opt/protenix_opt/modes.py README_ROWS ("8.0|3.7", "8.0|*"); levers of the H100
#    rows whose switches the 8.0 rows do not export are not part of the modes here and are named at activation on the CARD LEVER SET line:
#    pad8, dit_attn_exact, atom_attn_exact, triatt_prologue_cuda (exact); pf_attn, opm_fused, pwa_fused, cond_dedupe, dit_fused, dit_lowp,
#    atom_fused, triatt_prologue_cuda (fast, big). triatt_prologue_cuda is an sm_90a binary with no sm_80 build.
#  - blk2_block_path: engaged (CELLS.json blk2_arch carries sm80). Its fused tri-attention statement (prologue -> attention core -> epilogue:
#    mk_pf F1 prologue with the LayerNorm in registers, the arm's attention core, glue_v2 epilogue, all on the shared core's cc-8.0 cells) runs
#    from CELLS.json blk2_triatt_min_tokens (sm80: 400 tokens) up; below that the block core runs the STOCK tri-attention statement by name
#    (`[FPF] BLK: fused tri-attention statement -> stock tri-attention statement below 400 tokens on gpu_arch=sm80`, tally blk_triatt_below_tokens).
#    blk2_triatt_stock_arch is empty: no configured card runs the stock statement for want of cells. From the floor up the arm is H100's: nomask and
#    blk2_chunked_exact (exact), blk2_chunked_k2b and k2b_flash_triattention (fast, big: K2B is the attention core of the fused statement on its
#    sm80 cell, or the shared core's triangle-attention provider by the tier word where it has a cell for this card), glue_v2 and mk_pf (both arms).
#  - The pair-stack TriMul (c_z 256): opt_core.kernels.trimul by the mode's tier word (trimul_core_exact / trimul_core); exact serves only the
#    shapes the provider holds a bitwise cell for on this stack, else the library op by name.
#  - dit_attn / dit_attn_fp16 / atom_attn (fast, big): bound through the shared core's attention-with-pair-bias provider on this card's cells
#    (protenix_opt/apb_core.py); the LEVER lines print the cell and word served.
#  - Transitions (transition_core_exact | transition_core): every Transition call and the block statement's in-block pair transition through
#    opt_core.kernels.transition by the mode's tier word on this card's cells; under exact the provider's bitwise row from its own token floor up
#    and the stock statement below it by name — the provider's word carries the floor, there is no kit GEMM-row floor or per-row-count guard
#    (t1_guard_by_m_arch) in the unit; t1_fused_transition's forward (two GEMMs + the fused silu*mul) answers the calls the provider hands back.
#  - big at large N: the XL policy's lean tri-attention statements and blockfuse_xl are statements of the fused tri-attention path, so with the
#    sm_80 cells both install on this card; they act above the row-chunking threshold only (PTX_FPF_CHUNK_TOK=auto, sized to the device) — the
#    `[FPF] XLMEM` exit line's lean_triatt_stmts and the `[FPF] BLOCKFUSE` line count what ran.
#  - sampler_graph (exact, fast): the graphed sampler's token cap is sized to the device's memory (modes.sampler_graph_maxtok: 1536 tokens on a
#    device with at least 64 GiB, so on the 80 GB part; 995 on the 40 GB part, above which the stock sampler runs) — the unit's
#    `[fpf_clisampler] SAMPLER:on(...)` line prints it as max_tokens=.
#  - Stack: the stock fast-LayerNorm extension must carry sm_80 code (STOCK.md 'Stack').
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -m protenix_opt._stackkey) || { echo "[protenix-opt] NOT ACTIVE: the JIT cache key probe (python -m protenix_opt._stackkey) exited $? — see its line above" >&2; return 3 2>/dev/null || exit 3; }; fi; export MODEL_OPT_STACK_KEY   # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.13.0-cu130-sm90
if [ -z "${PROTENIX_ROOT_DIR:-}" ]; then echo "[protenix-opt] NOT ACTIVE: PROTENIX_ROOT_DIR is not set — see the kit's Variables table (the weights root: checkpoint/protenix-v2.pt + common/; the stock CLI downloads what is missing under it)" >&2; return 3 2>/dev/null || exit 3; fi
export PROTENIX_ROOT_DIR                                                                                              # weights root: required, no default
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                            # the optional persistent cache root <root>/<stack key>/{torch_extensions,triton} + <root>/weights; a pre-set directory below is kept as given
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}      # JIT caches, persistent, keyed by the running torch+CUDA+arch
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}
  export PROTENIX_OPT_CACHE_DIR=${PROTENIX_OPT_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/weights}                               # the kit's cache root: the weights digest memo weights_digests.json lives here (manifest.cache_dir; ~/.cache/protenix_opt when unset)
fi
export LAYERNORM_TYPE=${LAYERNORM_TYPE:-fast_layernorm} PYTHONDONTWRITEBYTECODE=1                                   # stock default LayerNorm kernel (the kit's env.sh default too); no .pyc in the mounted tree
# The prebuilt stream-correct fast-LayerNorm (opt/forward/flashpairformer/third_party/fastln_prebuilt*/ — one build per torch version, each with a
# manifest naming its torch) is selected by opt/forward/flashpairformer/env.sh for the installed torch version; pre-set INFOPT_FASTLN_PREBUILT to override.
