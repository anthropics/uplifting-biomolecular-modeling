# H200 deployment parameters. The mode is NOT here: it comes from `--mode` or PROTENIX_OPT=exact|fast|big|off.
# usage: `source configs/h200.env` then `PROTENIX_OPT=exact protenix pred ...` (the installed protenix_opt package activates at interpreter start),
#        or `run.sh pred|check|warm --config h200 --mode exact ...`. Every value can be pre-set in the environment; this file fills what is unset,
#        except PROTENIX_ROOT_DIR (the weights root), which has no default: unset, this file refuses by name (rc 3). MODEL_OPT_JIT_ROOT (optional) is
#        a persistent cache root: set, the JIT caches and the kit's cache root are exported under it; unset, nothing is exported for them and each tool
#        keeps its own default. STOCK.md 'Variables' lists them all.
# The drop-in route works only with protenix_opt installed on the `python` on PATH: this file refuses (rc 2) when it is not, so stock never runs silently;
# an interpreter that itself refuses to start (the kit's start-up gate on an undeclared PROTENIX_OPT* name, exit 3) is reported in its own words with its own code.
# The card: NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0 — the SAME capability key as the H100: every cell table, kernel row,
# prebuilt binary and lever of this kit is keyed by compute capability (or by the running torch/CUDA stack), so this card reads EXACTLY the H100 entries;
# no memory gate is retuned (the card's larger memory is headroom, not a different plan).
# This file is configs/h100.env restated for the H200: every statement identical except the target-GPU word (and this file's own name in its
# messages); per-card differences from configs/h100.env — the complete list: NONE in any mode's lever set, kernel rows, size gates or refusals.
# H200 uses the H100 settings; behaviour on H100 is unchanged (this file is read only under --config h200).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this protenix_v2/ directory (the package locates opt/ through it)
# Presence probe (find_spec executes nothing of the package): 41 = genuinely absent -> 'not installed', rc 2 (127/126: no usable python on PATH, rc 2); any other
# non-zero exit is the interpreter's own start-up refusal (the kit's hook: an undeclared PROTENIX_OPT* name, exit 3) - printed verbatim, and this file returns ITS code.
_ptx_probe_rc=0; _ptx_probe_err=$(env -u PROTENIX_OPT -u PROTENIX_OPT_N_GPU -u PROTENIX_OPT_TP_ROUTE python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('protenix_opt') else 41)" 2>&1 >/dev/null) || _ptx_probe_rc=$?
if [ "$_ptx_probe_rc" -eq 41 ] || [ "$_ptx_probe_rc" -eq 127 ] || [ "$_ptx_probe_rc" -eq 126 ]; then
  echo "[protenix-opt] NOT ACTIVE: protenix_opt is not installed on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/opt" >&2; unset _ptx_probe_rc _ptx_probe_err; return 2 2>/dev/null || exit 2
elif [ "$_ptx_probe_rc" -ne 0 ]; then
  [ -n "$_ptx_probe_err" ] && printf '%s\n' "$_ptx_probe_err" >&2
  echo "[protenix-opt] NOT ACTIVE: $(command -v python) exited $_ptx_probe_rc before the protenix_opt probe could run (its words above)" >&2
  _r=$_ptx_probe_rc; unset _ptx_probe_rc _ptx_probe_err; return "$_r" 2>/dev/null || exit "$_r"
fi
unset _ptx_probe_rc _ptx_probe_err
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0); check/pred report a mismatch
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then MODEL_OPT_STACK_KEY=$(python -m protenix_opt._stackkey) || { echo "[protenix-opt] NOT ACTIVE: the JIT cache key probe (python -m protenix_opt._stackkey) exited $? — see its line above" >&2; return 3 2>/dev/null || exit 3; }; fi; export MODEL_OPT_STACK_KEY   # the JIT cache key torch<version sans local tag>-cu<CUDA version sans dot>-sm<compute capability digits>, e.g. torch2.13.0-cu130-sm90
if [ -z "${PROTENIX_ROOT_DIR:-}" ]; then echo "[protenix-opt] NOT ACTIVE: PROTENIX_ROOT_DIR is not set — see the kit's Variables table (the weights root: checkpoint/protenix-v2.pt + common/; the stock CLI downloads what is missing under it)" >&2; return 3 2>/dev/null || exit 3; fi
export PROTENIX_ROOT_DIR                                                                                              # weights root: required, no default
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                            # the optional persistent cache root <root>/<stack key>/{torch_extensions,triton} + <root>/weights; a pre-set directory below is kept as given
  export TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/torch_extensions}      # JIT caches, persistent, keyed by the running torch+CUDA+arch
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}
  export PROTENIX_OPT_CACHE_DIR=${PROTENIX_OPT_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/weights}                               # the kit's cache root: the weights digest memo weights_digests.json lives here (manifest.cache_dir; ~/.cache/protenix_opt when unset)
fi
export LAYERNORM_TYPE=${LAYERNORM_TYPE:-fast_layernorm} PYTHONDONTWRITEBYTECODE=1                                   # stock default LayerNorm kernel (the kit's env.sh default too); no .pyc in the mounted tree
# The prebuilt stream-correct fast-LayerNorm (opt/forward/flashpairformer/third_party/fastln_prebuilt*/ — one build per torch version, each with a
# manifest naming its torch) is selected by opt/forward/flashpairformer/env.sh for the installed torch version; pre-set INFOPT_FASTLN_PREBUILT to override.
