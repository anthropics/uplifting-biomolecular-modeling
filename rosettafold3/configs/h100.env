# H100 deployment parameters (configs/a100.env: the A100 label over these same parameters). The mode is NOT here: it comes from `--mode` or ROSETTAFOLD3_OPT; no
# RF3_* switch is ever set by a config (the mode table is opt/rosettafold3_opt/modes.py). usage: `run.sh pred|check|warm|install
# --config h100 [--mode <mode>] ...`, or `source configs/h100.env` before calling the package directly. Every value can be pre-set in the
# environment; this file fills what is unset. It refuses (rc 3, the package's NOT ACTIVE line) when rosettafold3_opt or its pinned core
# is not importable on the interpreter it selects (opt/venv/bin/python when that exists, else `python` on PATH). Pinned stack: python 3.12, torch 2.13.0+cu130, triton 3.7.1,
# cuequivariance 0.11.1 (stock/PINS.json "pinned_stack").
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this rosettafold3/ directory (the package locates the kits through it)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H100}                                                            # the GPU this configuration targets (compute capability 9.0); check notes a mismatch with the visible GPU
export ROSETTAFOLD3_OPT_STOCK_PYTHON=${ROSETTAFOLD3_OPT_STOCK_PYTHON:-$MODEL_OPT/stock/venv/bin/python}                 # the pristine interpreter (state stock; never written by install.sh)
export ROSETTAFOLD3_OPT_PYTHON=${ROSETTAFOLD3_OPT_PYTHON:-$( [ -x "$MODEL_OPT/opt/venv/bin/python" ] && echo "$MODEL_OPT/opt/venv/bin/python" || command -v python )}   # the patched interpreter (state patched; the add-on's install.sh applied once by `run.sh install`)
if [ -n "${ROSETTAFOLD3_OPT_CKPT:-}" ]; then export ROSETTAFOLD3_OPT_CKPT; fi                                            # the pinned checkpoint (stock/PINS.json "weights": filename, url, sha256, bytes): a deployment path read from the environment, no default
                                                                                                                       # (README "Variables"); pred / warm refuse by name without it, check reports it absent
if [ -z "${MODEL_OPT_STACK_KEY:-}" ]; then                                                                             # the JIT cache key torch<version sans local tag>-sm<compute capability digits>, e.g. torch2.13.0-sm90 ('unknown' names a
  _rc=0; _req=$("$ROSETTAFOLD3_OPT_PYTHON" -m rosettafold3_opt._require 2>&1) || _rc=$?                                # probe without torch or GPU); the probe goes through the package's producer check first: whatever it prints is surfaced
  if [ "$_rc" -ne 0 ]; then                                                                                           # verbatim and this file returns ITS exit code (NOT ACTIVE → 3; any other import-time failure → that rc); 'not installed'
    [ -n "$_req" ] && echo "$_req" >&2                                                                                # only when the package has no import location on the interpreter (then rc 3) — never an empty or defaulted key
    _abs=0; [ "$_rc" -eq 3 ] || { ( _py=$ROSETTAFOLD3_OPT_PYTHON; for _v in $(compgen -e | grep '^ROSETTAFOLD3_OPT' || true); do unset "$_v"; done; exec "$_py" -c 'import importlib.util, sys; sys.exit(0 if importlib.util.find_spec("rosettafold3_opt") is not None else 41)' ) 2>/dev/null || _abs=$?; }   # 3 = refused by name; else the ONE absence question on a stripped interpreter (sentinel 41)
    if [ "$_abs" -ne 41 ]; then
      echo "[rosettafold3-opt] configs/h100.env: nothing exported past MODEL_OPT_STACK_KEY — the package refused or failed on $ROSETTAFOLD3_OPT_PYTHON (its line above, rc $_rc)" >&2
    else
      _rc=3; echo "[rosettafold3-opt] configs/h100.env: rosettafold3_opt is not installed on $ROSETTAFOLD3_OPT_PYTHON ($ROSETTAFOLD3_OPT_PYTHON -m pip install -e $MODEL_OPT/opt); nothing exported past MODEL_OPT_STACK_KEY" >&2
    fi
    unset _req _abs; return $_rc 2>/dev/null || exit $_rc; fi
  MODEL_OPT_STACK_KEY=$("$ROSETTAFOLD3_OPT_PYTHON" -c "from rosettafold3_opt import stack, modes; up = stack.upstream_versions(); g = stack.gpu_info(); print(modes.jit_cache_key((up.get('torch') or '').split('+')[0] or None, g['cc'] if g else None) or 'unknown')") || {
    echo "[rosettafold3-opt] configs/h100.env: the stack-key probe failed on $ROSETTAFOLD3_OPT_PYTHON (traceback above); nothing exported past this line" >&2
    unset _req MODEL_OPT_STACK_KEY; return 3 2>/dev/null || exit 3; }
  unset _req _rc
fi
export MODEL_OPT_STACK_KEY
if [ -n "${MODEL_OPT_JIT_ROOT:-}" ]; then                                                                              # persistent JIT caches under the cache root the deployment names (README "Variables"), keyed by the running torch+arch;
  export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/triton}                        # a pre-set directory is kept. Triton JIT cache (the launchers torch / cuEquivariance compile at first use)
  export TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$MODEL_OPT_JIT_ROOT/$MODEL_OPT_STACK_KEY/inductor}         # torch's inductor cache, keyed the same way (no mode compiles; torch honours it whenever inductor runs)
  export ROSETTAFOLD3_OPT_DIGEST_DIR=${ROSETTAFOLD3_OPT_DIGEST_DIR:-$MODEL_OPT_JIT_ROOT/weights}                      # the weights digest memo (weights_digests.json): beside the JIT caches, shared by every stack key; check rewrites it afresh
fi                                                                                                                     # no root named: TRITON_CACHE_DIR / TORCHINDUCTOR_CACHE_DIR stay as set (else the libraries' own defaults); the memo dir per weights.memo_dir
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
