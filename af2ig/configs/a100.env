# A100 (compute capability 8.0; the 80 GB and the 40 GB parts alike) deployment parameters; the same shape as configs/h100.env. The mode is NOT here: it comes from `--mode` or AF2IG_OPT. The lever
# values are the mode table's (opt/af2ig_opt/modes.py) and nothing in this file changes them. usage: `run.sh pred|check|warm --config a100 --mode <mode> ...`, or
# `source configs/a100.env` before calling the package directly. Every value can be pre-set in the environment; this file
# fills what is unset. It refuses (rc 3, NOT ACTIVE) when af2ig_opt is not installed on the `python` on PATH (every route, the stock route included, goes
# through the package); a package whose import itself fails or refuses returns that python's own status, its words untouched. Pinned stack: python 3.11, jax/jaxlib 0.5.3 with the CUDA-12 plugin, dm-haiku 0.0.16, tensorflow-cpu 2.21.0,
# numpy 1.26.4 (stock/PINS.json; environment/requirements.lock). AF2IG_DIR and AF2_PARAMS (the kit's own variables) are NOT here: they name the checkout and the weights
# of the installation and must be in the environment before this file is sourced.
# PER-CARD DIFFERENCES from configs/h100.env — the complete list; anything not named here is identical to the H100 (same modes, same lever
# sets, same size gates, same exit rules: a lever of the mode that does not engage is a partial run, exit 3 unless --allow-partial):
#   1. MODEL_OPT_TARGET_GPU defaults to A100 (below).
#   2. Lever set: NO difference — off/exact/fast/big carry the H100's levers. The fused Pallas levers (L10 -fused_triattn, L11 -fused_trimul)
#      read the shared core's compute-capability 8.0 float32 tile rows (opt_core fpf_pallas_serve TILE_TABLES['8.0'], chosen per jax line for
#      sm_80's 163 KB shared memory): tile geometry only, the same kernels and precision words (dtype=f32 precision=tf32, `tiles=own:8.0` on the
#      LEVER lines). L8 -flash_attn has no per-card table. The core's 'tf32x3' triangle-attention precision is unlaunchable on 8.0 by name;
#      no af2ig mode runs it.
#   3. No size floor, lever drop or single-stage tile applies to this card beyond the H100's own (the opt-in trimul_chunk floor 1473 is the same).
#   4. Memory: nothing here or in the mode table is sized to a card. XLA's pool is a fraction of whichever device is present (75 %; 95 % under
#      big), read by the runtime, never from the card's name; the trimul_chunk floor is a residue count. An 80 GB and a 40 GB A100 differ only
#      in how large a complex each mode holds: a design that does not fit is reported by the driver (`Struct with tag … failed …`, XLA's
#      `RESOURCE_EXHAUSTED: Out of memory …`) and the run exits 1 with `items=` short on its EXIT line — no lever falls back, nothing is silent.
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this af2ig/ directory — read by the NOT ACTIVE install hint below, set by run.sh too; the package locates the kit through AF2IG_OPT_HOME / AF2IG_OPT_KIT (opt/af2ig_opt/stack.py)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-A100}                                                            # the GPU this configuration targets (an A100, 80 GB or 40 GB; XLA preallocates 75 % of the card present); `off`/`exact` run as on the H100 (exact == off under `--det 1` on this card), the fused Pallas levers of `fast`/`big` are served from the shared core's compute-capability 8.0 tile rows (opt_core fpf_pallas_serve TILE_TABLES); on a core without those rows the two levers step aside by name (`skipped=L10,L11`, `LEVER … state=skipped reason=cannot_run:…`) and the mode runs its remaining levers
export AF2IG_OPT_JIT_ROOT=${AF2IG_OPT_JIT_ROOT:-${MODEL_OPT_JIT_ROOT:-${HOME:-/root}/.cache/af2ig_opt/jit}}                          # the compile-cache root: <root>/<stack key>/<recipe>/{jax,programs} on first use (this default, or MODEL_OPT_JIT_ROOT, or the kit's own AF2IG_OPT_JIT_ROOT, which wins); a JAX_COMPILATION_CACHE_DIR you preset stays your cache directory (kept as given) unless a root was named before run.sh read this file — MODEL_OPT_JIT_ROOT / AF2IG_OPT_JIT_ROOT exported by you, or an image's shipped cache — in which case run.sh drops it and both caches go under the root
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
python -c "import importlib.util, sys; sys.exit(4) if importlib.util.find_spec('af2ig_opt') is None else None; import af2ig_opt, af2ig_opt._core_gate as g; g.gate(list(af2ig_opt.__path__)[0], tag=af2ig_opt.TAG)" || { rc=$?; [ $rc != 4 ] || { echo "[af2ig-opt] NOT ACTIVE: package_missing:af2ig_opt on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; rc=3; }; return $rc 2>/dev/null || exit $rc; }   # the package (a genuine absence is the one `package_missing` word, rc 3) AND its core pin gate (af2ig_opt/_core_gate.py: NOT ACTIVE reason=core_missing:opt_core | core_mismatch: … | core_pin_unreadable: …, rc 3); any other failure of the import passes through with that python's own words and status
# The kernel levers of fast / big carry no switch here: the shared core's provider picks each call's implementation from the mode's tier word.
# big's opt-in: the row-chunked TriangleMultiplication, composed by no shipped mode (CHANGES.md); `on` = 256 rows from 1,473 residues, or <rows>:<min residues>.
# export AF2IG_OPT_TRIMUL_CHUNK=on
