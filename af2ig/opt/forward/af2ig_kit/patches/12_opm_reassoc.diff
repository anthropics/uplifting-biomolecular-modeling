     _mprobe = FUSED_TRIMUL.setup()
     print(f"fused_trimul: block {FUSED_TRIMUL.IMPL} origin=core jax={_mprobe.get('jax')} cc={_mprobe.get('cc')} tiles={_mprobe.get('tiles')} precision={_mprobe.get('precision')}")
