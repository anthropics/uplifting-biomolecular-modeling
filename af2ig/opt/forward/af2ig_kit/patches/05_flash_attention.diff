     q = jnp.einsum('bqa,ahc->bqhc', q_data, q_weights) * key_dim**(-0.5)
     k = jnp.einsum('bka,ahc->bkhc', m_data, k_weights)
     v = jnp.einsum('bka,ahc->bkhc', m_data, v_weights)
-    logits = jnp.einsum('bqhc,bkhc->bhqk', q, k) + bias
-    if nonbatched_bias is not None:
-      logits += jnp.expand_dims(nonbatched_bias, axis=0)
-    weights = jax.nn.softmax(logits)
-    weighted_avg = jnp.einsum('bhqk,bkhc->bqhc', weights, v)
+    weighted_avg = None
+    if self.global_config.use_flash_attention:
+      # Tier-2 lever L8 (kit): the attention core (logits + mask/pair bias,
+      # softmax, weighted sum) computed by the kit's flash-attention adapter
+      # (af2ig_opt.flash_attn.core -> the tree's shared Pallas kernel) without
+      # materialising the [b, h, q, k] logits; None = a call the kernel does not
+      # take (counted with its reason there), which runs the stock ops below.
+      # Not bitwise vs the stock ops (re-associated softmax reductions).
+      from af2ig_opt import flash_attn as _flash_attn
+      weighted_avg = _flash_attn.core(q, k, v, bias, nonbatched_bias, key_dim, value_dim)
+    if weighted_avg is None:
+      logits = jnp.einsum('bqhc,bkhc->bhqk', q, k) + bias
+      if nonbatched_bias is not None:
+        logits += jnp.expand_dims(nonbatched_bias, axis=0)
+      weights = jax.nn.softmax(logits)
+      weighted_avg = jnp.einsum('bhqk,bkhc->bqhc', weights, v)
 
     if self.global_config.zero_init:
       init = hk.initializers.Constant(0.0)
