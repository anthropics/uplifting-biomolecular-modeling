     print(f"fused_triattn: block {FUSED_TRIATTN.IMPL} origin=core jax={_tprobe.get('jax')} cc={_tprobe.get('cc')} tiles={_tprobe.get('tiles')} precision={_tprobe.get('precision')} key_mask={_tprobe.get('key_mask')}")
