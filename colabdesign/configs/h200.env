# H200 deployment parameters. The mode is NOT here: it comes from `--mode` or
# COLABDESIGN_OPT=off|exact|fast (or <mode>-no-<lever>). usage: `run.sh design|check|warm --config h200 [--mode <mode>] ...`, or
# `source configs/h200.env` before calling the package directly. Every value can be pre-set in the environment; this file
# fills what is unset. The AlphaFold params root is not set here: it is the caller's COLABDESIGN_PARAMS_DIR or `--params-dir`
# (STOCK.md Variables; default BindCraft's folder stock/src/bindcraft; design / warm refuse by name a root without params/, check words the weights `not checked`). It refuses (rc 3) when colabdesign_opt is not installed on the `python` on PATH (every route, the stock route included,
# goes through the package). Pinned stack: python 3.10.18, jax 0.6.0 + jaxlib 0.6.0 + jax-cuda12-plugin 0.6.0, dm-haiku 0.0.17,
# colabdesign 1.1.3 @ e31a56fe, no triton distribution (stock/PINS.json "pins").
# The card: NVIDIA H200, 141 GB = 143,771 MiB nvidia-smi, compute capability 9.0 — the SAME capability key as the H100: every cell table, kernel row,
# prebuilt binary and lever of this kit is keyed by compute capability (or by the running torch/CUDA stack), so this card reads EXACTLY the H100 entries;
# no memory gate is retuned (the card's larger memory is headroom, not a different plan).
# This file is configs/h100.env restated for the H200: every statement identical except the target-GPU word (and this file's own name in its
# messages); per-card differences from configs/h100.env — the complete list: NONE in any mode's lever set, kernel rows, size gates or refusals.
# H200 uses the H100 settings; behaviour on H100 is unchanged (this file is read only under --config h200).
export MODEL_OPT=${MODEL_OPT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}                                     # this colabdesign/ directory (the package locates the kit tree and the stock pins through it)
python -c "import importlib.util, sys; sys.exit(4) if importlib.util.find_spec('colabdesign_opt') is None else None; import colabdesign_opt, colabdesign_opt._core_gate as g; g.gate(list(colabdesign_opt.__path__)[0], tag=colabdesign_opt.TAG)" || { [ $? = 3 ] || echo "[colabdesign-opt] NOT ACTIVE: package_missing:colabdesign_opt on $(command -v python || echo 'python (not on PATH)'): pip install -e $MODEL_OPT/../common/opt_core -e $MODEL_OPT/opt" >&2; return 3 2>/dev/null || exit 3; }   # the package AND its core pin gate (colabdesign_opt/_core_gate.py: NOT ACTIVE reason=core_missing:opt_core | core_mismatch: … | core_pin_unreadable: …, rc 3)
export MODEL_OPT_TARGET_GPU=${MODEL_OPT_TARGET_GPU:-H200}                                                            # the GPU this configuration targets (compute capability 9.0); check/design record a mismatch
export PYTHONDONTWRITEBYTECODE=1                                                                                     # no .pyc in the mounted tree
